@model System.Collections.Generic.IReadOnlyList<GTX.CarCare.Models.CarCareService>
@{
    ViewBag.Title = "Good care for the road ahead";
    ViewBag.Description = "GTX Car Care Center: tire changes, oil changes, wheel alignments, car detailing, and car washes. Call (513) 489-2886 for pricing and availability.";
}
<section class="care-hero" aria-labelledby="hero-title">
    <div class="care-hero-lines" aria-hidden="true"></div>
    <div class="care-shell care-hero-inner">
        <div class="care-hero-copy">
            <p class="care-eyebrow"><span class="care-small-line"></span> GTX CAR CARE CENTER</p>
            <div class="care-hero-slogan"><span>Your car.</span><span>Your everyday.</span><strong>Your GTX.</strong></div>
            <h1 id="hero-title">Good care.<br /><span>Great miles.</span></h1>
            <p class="care-hero-lead">A smoother drive. A fresher feel.<br />A little more pride in every mile.</p>
            <p class="care-hero-description">Tires, oil changes, alignments, detailing, and car washes. The everyday essentials, with the GTX touch.</p>
            <div class="care-actions">
                <a class="care-button care-button-light" href="@CarCareContent.PhoneLink">Call to plan your visit</a>
                <a class="care-button care-button-outline" href="@Url.RouteUrl("Services")">Explore our services</a>
            </div>
            <p class="care-hero-note">Let's talk about what your car needs. <a href="@CarCareContent.PhoneLink">@CarCareContent.Phone</a></p>
        </div>
        <aside class="care-service-board" aria-labelledby="board-title">
            <div class="care-board-heading">
                <span class="care-eyebrow">MAINTENANCE &amp; FINISHING TOUCHES</span>
                <h2 id="board-title">A little care.<br />A world of difference.</h2>
                <p>Find your next service.</p>
            </div>
            <div class="care-board-services">
                @foreach (var service in Model)
                {
                    <a href="@(Url.RouteUrl("Services") + "#" + service.Id)">
                        <span class="care-icon-tile">@Html.Partial("_ServiceIcon", service.Id)</span>
                        <span>@service.Name</span>
                    </a>
                }
            </div>
            <div class="care-board-footer">YOUR NEXT GOOD MILE STARTS HERE.</div>
        </aside>
    </div>
</section>
<section class="marketing-page" aria-labelledby="services-title">
    <div class="care-shell care-section">
        <div class="care-section-heading">
            <div><p class="care-eyebrow">THE EVERYDAY ESSENTIALS</p><h2 id="services-title">Our car care services</h2></div>
            <p>Keep up with the miles. Freshen up the details.<br />Choose the care that fits your car.</p>
        </div>
        <div class="care-cards">
            @foreach (var service in Model)
            {
                <a class="care-card" href="@(Url.RouteUrl("Services") + "#" + service.Id)">
                    <div class="care-card-top"><span class="care-icon-tile">@Html.Partial("_ServiceIcon", service.Id)</span></div>
                    <h3>@service.Name</h3>
                    <p>@service.Tagline</p>
                    <span class="care-card-link">Explore service</span>
                </a>
            }
        </div>
        <section class="care-process" aria-labelledby="process-title">
            <div><p class="care-eyebrow">LESS GUESSWORK. MORE GOING.</p><h2 id="process-title">Simple from<br />the first hello.</h2><p class="care-process-intro">A conversation is all it takes to get started.</p></div>
            <ol>
                <li><strong>Tell us about your car.</strong><span>Share your vehicle details and the care you have in mind.</span></li>
                <li><strong>Find the right service.</strong><span>Talk through options, pricing, and available times.</span></li>
                <li><strong>Plan your visit.</strong><span>Confirm the details with our team before heading over.</span></li>
            </ol>
        </section>
    </div>
</section>
