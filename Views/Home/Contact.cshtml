@model GTX.Models.ContactModel
@{
    var isTestDrive = Model != null && Model.IsTestDrive;
    var heroKicker = isTestDrive ? "Your next drive starts here" : "Real people. Straight answers.";
    var heroTitle = isTestDrive ? "Take the wheel." : "Let’s start";
    var heroAccent = isTestDrive ? "Feel the difference." : "a conversation.";
    var heroDescription = isTestDrive
        ? "Choose a date and time that works for you. We’ll have everything ready when you arrive."
        : "Ask a question, plan a visit, or tell us what you’re looking for. Our team is ready to help.";
}

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-L828PN8ET1"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-L828PN8ET1');
</script>

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", heroKicker },
    { "Title", heroTitle },
    { "Accent", heroAccent },
    { "Description", heroDescription },
    { "Word", isTestDrive ? "DRIVE" : "HELLO" },
    { "Icon", isTestDrive ? "bi-speedometer2" : "bi-chat-dots" }
})

<main class="marketing-page contact-page @(isTestDrive ? "test-drive-page" : string.Empty)">
    <section class="marketing-content-shell">
        <div class="marketing-section-label">
            <span>@(isTestDrive ? "Reserve your drive" : "Visit or message us")</span>
            <small>9516 Princeton Glendale Rd · West Chester, Ohio</small>
        </div>

        <div class="contact-layout">
            <aside class="contact-showroom">
                <div class="contact-showroom-photo">
                    <img src="@SiteImageUrl.Build("gtx.jpg")" alt="GTX Auto Group showroom" />
                    <span class="contact-showroom-photo-copy">
                        <small>Your local showroom</small>
                        <strong>Come see what feels right.</strong>
                    </span>
                </div>

                <div class="contact-showroom-details">
                    <address class="contact-address">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                        <span><strong>GTX Auto Group</strong><br />9516 Princeton Glendale Rd<br />West Chester Twp, OH 45011</span>
                    </address>

                    <div class="contact-actions">
                        <a class="contact-action" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&amp;query=9516+Princeton+Glendale+Rd%2C+West+Chester%2C+OH+45011">
                            <i class="bi bi-sign-turn-right-fill" aria-hidden="true"></i> Directions
                        </a>
                        <a class="contact-action" href="tel:+15134892886">
                            <i class="bi bi-telephone-fill" aria-hidden="true"></i> (513) 489-2886
                        </a>
                    </div>
                </div>
            </aside>

            <section class="contact-form-panel" aria-labelledby="contactPanelTitle">
                <header class="contact-panel-heading">
                    <i class="bi @(isTestDrive ? "bi-calendar2-check" : "bi-envelope-paper-heart")" aria-hidden="true"></i>
                    <span>
                        <small>@(isTestDrive ? "Choose your preferred time" : "We usually respond promptly")</small>
                        <strong id="contactPanelTitle">@ViewBag.Message</strong>
                    </span>
                </header>
                @{ Html.RenderPartial("_ContactForm", Model); }
            </section>
        </div>
    </section>
</main>
