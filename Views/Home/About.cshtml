@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", "Driven by trust since day one" },
    { "Title", "More than cars." },
    { "Accent", "A better journey." },
    { "Description", "A West Chester dealership built around honest guidance, carefully selected vehicles, and people who genuinely listen." },
    { "Word", "STORY" },
    { "Icon", "bi-compass" }
})

<main class="marketing-page about-page">
    <section class="marketing-content-shell">
        <div class="marketing-section-label">
            <span>Our story</span>
            <small>GTX Auto Group &middot; West Chester, Ohio</small>
        </div>

        <div class="about-feature">
            <figure class="about-video-frame">
                <video autoplay muted loop playsinline preload="metadata">
                    <source src="@Url.Content("~/SiteImages/video/GTX-1.mov")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
                <figcaption class="about-video-caption">
                    <span>Welcome to GTX Auto Group</span>
                    <i class="bi bi-play-circle" aria-hidden="true"></i>
                </figcaption>
            </figure>

            <article class="about-story">
                <h2>Simple. Honest.<br />Stress-free.</h2>
                <p>Everything you need to find the right car&mdash;simple, honest, and stress-free.</p>

                <p>
                    West Chester, where highways hum and dreams take flight,
                    There stands a place of promise&mdash;GTX Auto Group, glowing bright.
                    Beneath wide Ohio skies and sunlit dealership lots,
                    They offer not just steel and wheels, but trust in every thought.
                </p>
                <p>
                    Here, engines rest like sleeping lions, ready to awaken,
                    Polished chrome and handpicked care, each vehicle unshaken.
                    Trucks with shoulders broad as barns, SUVs like rolling hills,
                    Cars that whisper stories still untold, waiting to fulfill.
                </p>
                <p>
                    But more than horsepower or the gleam of paint in day&rsquo;s caress,
                    It&rsquo;s honesty that turns the key&mdash;the quiet strength of success.
                    No haggling shadows, no fine-print snares, no masks behind a smile,
                    Just friendly hands and open doors that stretch for country miles.
                </p>
                <p>
                    You&rsquo;ll find the team not selling dreams, but guiding you with grace,
                    They listen first, then help you match the road you&rsquo;re meant to face.
                    Whether you're chasing sunsets or the morning&rsquo;s early light,
                    There&rsquo;s a vehicle for every journey&mdash;priced to feel just right.
                </p>
                <p>
                    Each customer, a story, each handshake a vow,
                    That quality and care are not just words, but lived here, now.
                    A single visit feels like home, familiar and sincere,
                    Where choices bloom without regret and every path feels clear.
                </p>
                <p>
                    Stress dissolves like summer rain, replaced by calm and ease,
                    You leave not just with keys in hand, but a heart at peace.
                    Because GTX doesn&rsquo;t simply sell&mdash;they serve with all their might,
                    With integrity their cornerstone, and satisfaction their right.
                </p>
                <p>
                    So come where trust is built to last, where value holds its ground,
                    Where cars and kindness intertwine, and joy is always found.
                    For journeys born in West Chester&rsquo;s light, and built on proven trust,
                    GTX Auto Group is the name that rises up from dust.
                </p>

                <div class="about-values" aria-label="Our values">
                    <span class="about-value"><i class="bi bi-shield-check" aria-hidden="true"></i><strong>Integrity first</strong></span>
                    <span class="about-value"><i class="bi bi-chat-heart" aria-hidden="true"></i><strong>People always</strong></span>
                    <span class="about-value"><i class="bi bi-key" aria-hidden="true"></i><strong>Confidence delivered</strong></span>
                </div>
            </article>
        </div>
    </section>
</main>
