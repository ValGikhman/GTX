@model GTX.Models.BaseModel

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-L828PN8ET1"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-L828PN8ET1');
</script>

@{
    var hasAnnouncements = Model.Announcements?.Count() > 0;
    var displayMode = hasAnnouncements ? Model.Announcements[0].DisplayMode : GTX.Models.DisplayMode.Popup;
    var announcementId = hasAnnouncements ? Model.Announcements[0].Id : 0;
}

<section class="hero home-hero" aria-labelledby="homeHeroTitle">
    <video class="video-background-video" autoplay muted loop playsinline webkit-playsinline preload="metadata" aria-hidden="true" tabindex="-1">
        <source src="~/SiteImages/video/GTX.MP4" type="video/mp4" />
    </video>

    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-hero-grid" aria-hidden="true"></div>
    <span class="home-hero-orbit home-hero-orbit-one" aria-hidden="true"></span>
    <span class="home-hero-orbit home-hero-orbit-two" aria-hidden="true"></span>
    <span class="home-hero-brand" aria-hidden="true">
        <img src="~/SiteImages/brand-index.png" alt="" />
    </span>

    <div class="home-hero-shell">
        <div class="home-hero-copy">
            <p class="home-hero-slogan" aria-label="Your car, your style, your way">
                <span>Your car</span>
                <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
                <span>Your style</span>
                <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
                <strong>Your way</strong>
            </p>

            <h1 id="homeHeroTitle">
                Find the drive
                <span>that feels like you.</span>
            </h1>

            <p class="home-hero-lead">
                Carefully selected vehicles, straightforward guidance, and a local team ready to help you drive with confidence.
            </p>

            <div class="home-hero-primary-actions">
                <a href="@Url.Action("All", "Inventory")" class="home-hero-button home-hero-button-primary">
                    <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                    <span>@I18n.R("Nav_All") @I18n.R("Nav_Inventory")</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="@Url.RouteUrl("TestDriveContact")" class="home-hero-button home-hero-button-secondary">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>@I18n.R("Nav_ScheduleTestDrive")</span>
                </a>
            </div>

            <ul class="home-hero-trust list-unstyled" aria-label="Why choose GTX Auto Group">
                <li><i class="bi bi-star-fill" aria-hidden="true"></i> Top rated in Cincinnati</li>
                <li><i class="bi bi-shield-check" aria-hidden="true"></i> Straightforward buying</li>
                <li><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Local, personal service</li>
            </ul>
        </div>

        <aside class="home-hero-side" aria-label="Featured inventory and quick actions">
            @Html.Partial("_HomeInventoryPlayer", Model)

            <nav class="home-hero-quick-actions" aria-label="Quick actions">
                <a href="@Url.Action("Application", "Home")">
                    <span class="home-quick-icon"><i class="bi bi-currency-dollar" aria-hidden="true"></i></span>
                    <span><small>Financing</small><strong>@I18n.R("Nav_GetPrequalified")</strong></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>
                <a href="@Url.RouteUrl("Default", new { controller = "Home", action = "Contact" })">
                    <span class="home-quick-icon"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                    <span><small>Questions?</small><strong>@I18n.R("Nav_ContactUs")</strong></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>
                <a href="tel:+15134892886">
                    <span class="home-quick-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                    <span><small>Call our team</small><strong>(513) 489-2886</strong></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>
            </nav>
        </aside>
    </div>
</section>

<script>
    $(function () {
        $("#fakeSearch").css("visibility", "hidden");
        $("#GTX-image").removeClass("d-md-inline-block");

        var heroVideo = document.querySelector(".home-hero .video-background-video");
        if (heroVideo && window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            heroVideo.pause();
        }

        var inventoryPlayer = document.getElementById("homeInventoryPlayer");
        if (inventoryPlayer && window.bootstrap && bootstrap.Carousel) {
            var carousel = bootstrap.Carousel.getOrCreateInstance(inventoryPlayer, {
                interval: 5500,
                ride: "carousel",
                pause: "hover",
                touch: true,
                wrap: true
            });
            var playerButton = inventoryPlayer.querySelector("[data-home-player-toggle]");
            var playerCounter = inventoryPlayer.querySelector("[data-home-player-current]");
            var playerPaused = false;

            $(inventoryPlayer).on("slide.bs.carousel", function (event) {
                if (playerCounter) playerCounter.textContent = event.to + 1;
            });

            if (playerButton) {
                $(playerButton).on("click", function () {
                    playerPaused = !playerPaused;
                    if (playerPaused) {
                        carousel.pause();
                        $(this).find("i").removeClass("bi-pause-fill").addClass("bi-play-fill");
                        this.setAttribute("aria-label", "Play featured inventory");
                        this.setAttribute("title", "Play");
                    } else {
                        carousel.cycle();
                        $(this).find("i").removeClass("bi-play-fill").addClass("bi-pause-fill");
                        this.setAttribute("aria-label", "Pause featured inventory");
                        this.setAttribute("title", "Pause");
                    }
                });
            }

            if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                carousel.pause();
                playerPaused = true;
                if (playerButton) {
                    $(playerButton).find("i").removeClass("bi-pause-fill").addClass("bi-play-fill");
                    playerButton.setAttribute("aria-label", "Play featured inventory");
                    playerButton.setAttribute("title", "Play");
                }
            }
        }

        var hasAnnouncements = @((hasAnnouncements).ToString().ToLower());
        var displayMode = "@displayMode";
        var id = @announcementId;

        if (!hasAnnouncements) return;

        if (displayMode === "Popup") {
            previewAnnouncementPopup(id);
        } else if (displayMode === "BannerTop") {
            previewAnnouncementBanner(id);
        }
    });
</script>
