@model GTX.Models.BlogPostModel

@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model?.Title) ? "Blog Post" : Model.Title;

    string safeMediaUrl = SecuritySanitizer.SanitizeHttpOrRelativeUrl(Model?.MediaURL);
    string safeArticleUrl = SecuritySanitizer.SanitizeHttpOrRelativeUrl(Model?.ArticleURL);
    bool hasImg = !string.IsNullOrWhiteSpace(safeMediaUrl);
    string safeAuthor = string.IsNullOrWhiteSpace(Model?.Author) ? "Staff" : Model.Author;
    string safeTitle = string.IsNullOrWhiteSpace(Model?.Title) ? "Untitled" : Model.Title;

    // Safe-ish date formatting
    string dateText = (Model != null && Model.CreatedAt != default(DateTime))
        ? Model.CreatedAt.ToString("MMMM d, yyyy")
        : "";
}

<link href="~/Content/article-details.css?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/article-details.css")).Ticks)" rel="stylesheet" />
@Html.Partial("_MarketingHero", null, new ViewDataDictionary {
    { "Kicker", "GTX Auto Group" }, { "Title", "GTX" }, { "Accent", "Blog" },
    { "Description", "Stories, advice, and insights from GTX Auto Group." },
    { "Word", "BLOG" }, { "Icon", "bi-journal-richtext" }
})
<section class="container-fluid d-flex justify-content-center">
    <div class="row col-12 col-lg-9 col-xl-8 my-5 px-3">

        @if (Model == null)
        {
            <div class="alert alert-secondary rounded-4 shadow-sm w-100">
                Post not found.
            </div>
        }
        else
        {
            <article class="article-detail-card rounded-4 shadow-lg overflow-hidden p-0">

                <!-- Hero -->
                <div class="hero blog-hero position-relative">
                    @if (hasImg)
                    {
                        <img src="@safeMediaUrl"
                             alt="@safeTitle"
                             class="w-100 blog-hero-img" />
                        <div class="blog-hero-overlay"></div>
                    }
                    else
                    {
                        <div class="blog-hero-fallback d-flex align-items-center justify-content-center">
                            <div class="text-center">
                                <div class="blog-hero-icon mb-2">📰</div>
                                <div class="text-muted">No image</div>
                            </div>
                        </div>
                    }

                    <div class="blog-hero-content">
                        <h2 class="blog-title mb-3">@safeTitle</h2>
                        <div class="blog-meta d-flex flex-wrap gap-2 align-items-center">
                            <div class="d-flex flex-column">
                                <div class="fw-semibold">@safeAuthor</div>
                                @if (!string.IsNullOrWhiteSpace(dateText))
                                {
                                    <span class="badge rounded-pill bg-dark-subtle text-dark border my-1">@dateText</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="p-4 p-md-5">
                    <div class="blog-content">
                        @Html.Raw(SecuritySanitizer.SanitizeRichHtml(Model.Content))
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <a href="@Url.Action("List", "Blogs")" class="btn btn-outline-secondary rounded-4"><i class="bi bi-arrow-left" aria-hidden="true"></i> All blogs</a>
                        @if (!string.IsNullOrWhiteSpace(safeArticleUrl))
                        {
                            <a href="@safeArticleUrl"  target="_blank" rel="noopener" class="btn btn-gradient-grey border-dark rounded-4 text-shadow-small">
                                Open Original →
                            </a>
                        }
                    </div>
                </div>

            </article>
        }
    </div>
</section>
