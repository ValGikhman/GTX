@model IEnumerable<GTX.Models.BlogPostModel>

@{
    ViewBag.Title = "Blog";
    var posts = Model == null
        ? new System.Collections.Generic.List<GTX.Models.BlogPostModel>()
        : System.Linq.Enumerable.ToList(Model);

    string StripHtml(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        return System.Text.RegularExpressions.Regex.Replace(input, "<.*?>", string.Empty);
    }

    string Truncate(string input, int max)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var value = input.Trim();
        return value.Length <= max ? value : value.Substring(0, max).TrimEnd() + "…";
    }
}

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", "Ideas for the road ahead" },
    { "Title", "Stories worth" },
    { "Accent", "taking with you." },
    { "Description", "Buying guidance, dealership news, and thoughtful reads from the people who know the road." },
    { "Word", "READ" },
    { "Icon", "bi-journal-richtext" }
})

<main class="marketing-page blog-list-page">
    <section class="marketing-content-shell">
        <div class="marketing-section-label">
            <span>From the journal</span>
            <small>@posts.Count @(posts.Count == 1 ? "story" : "stories")</small>
        </div>

        @if (posts.Count == 0)
        {
            <div class="blog-empty">
                <i class="bi bi-journal" aria-hidden="true"></i>
                <strong>No stories yet.</strong>
                <p class="mb-0 mt-2">Fresh ideas are on the way.</p>
            </div>
        }
        else
        {
            <div class="blog-list-grid">
                @for (var index = 0; index < posts.Count; index++)
                {
                    var post = posts[index];
                    var safeAuthor = string.IsNullOrWhiteSpace(post.Author) ? "GTX Staff" : post.Author;
                    var safeTitle = string.IsNullOrWhiteSpace(post.Title) ? "Untitled story" : post.Title;
                    var preview = Truncate(StripHtml(post.Content), index == 0 ? 280 : 175);
                    var safeMediaUrl = SecuritySanitizer.SanitizeHttpOrRelativeUrl(post.MediaURL);
                    var hasImage = !string.IsNullOrWhiteSpace(safeMediaUrl);
                    var postUrl = Url.Action("Blog", "Blogs", new { id = post.Id });

                    <article class="blog-list-item">
                        <div class="blog-list-card">
                            <a class="blog-list-media" href="@postUrl" aria-label="Read @safeTitle">
                                @if (hasImage)
                                {
                                    <img src="@safeMediaUrl" alt="@safeTitle" loading="lazy" />
                                }
                                else
                                {
                                    <span class="blog-media-fallback"><i class="bi bi-newspaper" aria-hidden="true"></i></span>
                                }
                            </a>

                            <div class="blog-list-body">
                                <div class="blog-list-meta">
                                    <span>@safeAuthor</span>
                                    <i class="bi bi-circle-fill" aria-hidden="true"></i>
                                    <time datetime="@post.CreatedAt.ToString("yyyy-MM-dd")">@post.CreatedAt.ToString("MMM d, yyyy")</time>
                                </div>
                                <h2>@safeTitle</h2>
                                <p>@preview</p>
                                <a class="blog-read-link" href="@postUrl">
                                    Read the story <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</main>
