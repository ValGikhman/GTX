@using Extensions
@model List<GTX.Models.EmployeeModel>
<link href="~/Content/majordome.css?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/majordome.css")).Ticks)" rel="stylesheet" />

<div class="shadow rounded-4 overflow-hidden">

    <div class="card-header bg-white p-3 border-0 sticky-top" style="z-index: 1020;">
        <div class="d-flex align-items-center justify-content-end">
            <a id="newEmployee" class="btn btn-gradient"
               data-employee-modal="true"
               data-title="New Employee"
               href="@Url.Action("Create", "Employees")">
                <i class="bi bi-plus-lg me-1"></i> New
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <div id="employeesAddGrid" class="gtx-admin-add-grid"></div>
        <div class="d-none" aria-hidden="true">
            <table id="empTableSource">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:90px;">Photo</th>
                        <th style="min-width:170px;">Name</th>
                        <th style="min-width:100px;">Position</th>
                        <th style="min-width:200px;">Email</th>
                        <th style="min-width:140px;">Phone</th>
                        <th style="min-width:90px;">Status</th>
                        <th style="min-width:90px;">Added</th>
                        <th class="text-end" style="width:100px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center p-4 text-muted">
                                No employees yet. Click <strong>New</strong> to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model)
                        {
                            var hasPhoto = !string.IsNullOrWhiteSpace(e.PhotoPath);
                            var active = e.Active;

                            <tr data-grid-row="true" data-hasphoto="@(hasPhoto ? "1" : "0")" data-active="@(active ? "active" : "notactive")">
                                <td>
                                    @if (hasPhoto)
                                    {
                                        <img width="80" height="90" class="rounded-2 border" src="@Url.Content("~" + e.PhotoPath)" />
                                    }
                                    else
                                    {
                                        <img width="80" height="90" class="rounded-2 border" src="~/SiteImages/staff/empty.jpg" />
                                    }
                                </td>

                                <td>
                                    <div class="fw-semibold">@e.FirstName @e.LastName</div>
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(e.Position) ? "N/A" : e.Position)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Email) ? "N/A" : e.Email)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Phone) ? "N/A" : e.Phone.FormatPhone())</td>

                                <td>
                                    @if (e.Active)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle shadow">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>@e.CreatedDate.ToString("MM/dd/yyyy")</td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-gradient-grey btn-sm btn-outline-primary"
                                           data-employee-modal="true"
                                           data-title="Edit Employee"
                                           href="@Url.Action("Edit", "Employees", new { id = e.Id })">
                                            <i class="bi bi-pencil-square me-1"></i>
                                        </a>

                                        <button id="btnDeleteEmp-@e.Id"
                                                type="button"
                                                class="btn btn-gradient-grey btn-sm btn-outline-danger"
                                                onclick="deleteEmployee(@e.Id)"
                                                data-id="@e.Id"
                                                title="Delete">
                                            <i class="bi bi-trash me-1"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script type="text/x-addgrid-template" id="employee-grid-photo-template">{{PhotoHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-name-template">{{NameHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-position-template">{{PositionHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-email-template">{{EmailHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-phone-template">{{PhoneHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-status-template">{{StatusHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-added-template">{{AddedHtml}}</script>
<script type="text/x-addgrid-template" id="employee-grid-actions-template">{{ActionsHtml}}</script>

<script>
    async function deleteEmployee(id) {
        if (!id) return;

        const confirmed = await window.gtxConfirm({
            title: "Delete employee",
            message: "Delete this employee? This cannot be undone.",
            confirmText: "Delete",
            variant: "danger"
        });
        if (!confirmed) return;

        $.post(`${root}Employees/Delete`, { id: id })
            .done(function (res) {
                refreshEmployees();
            })
            .fail(function (xhr) {
                window.gtxAlert("Delete failed. Status: " + xhr.status);
            });
    };

    function refreshEmployees() {
        const $grid = $("#employeesAddGrid");
        window.gtxAdminGridState = window.gtxAdminGridState || {};
        window.gtxAdminGridState.employeesSearch = $grid.data("add-grid")
            ? $grid.addGrid("getSearch")
            : (window.gtxAdminGridState.employeesSearch || "");
        const listContainerSelector = "#tab-employees";

        $(listContainerSelector).load(`${root}Employees/ListPartial`);
    }

    $(function initializeEmployeesAddGrid() {
        const $source = $("#empTableSource");
        const rows = $source.find("tbody tr[data-grid-row='true']").map(function () {
            const $row = $(this);
            const $cells = $row.children("td");
            const photoState = $row.attr("data-hasphoto") === "1" ? "With Photo" : "No Photo";
            const name = $.trim($cells.eq(1).text());
            const position = $.trim($cells.eq(2).text());
            const email = $.trim($cells.eq(3).text());
            const phone = $.trim($cells.eq(4).text());
            const status = $.trim($cells.eq(5).text());
            const added = $.trim($cells.eq(6).text());

            return {
                PhotoState: photoState,
                Name: name,
                Position: position,
                Email: email,
                Phone: phone,
                Status: status,
                Added: added,
                SearchText: [name, position, email, phone, status].join(" "),
                PhotoHtml: $cells.eq(0).html(),
                NameHtml: $cells.eq(1).html(),
                PositionHtml: $cells.eq(2).html(),
                EmailHtml: $cells.eq(3).html(),
                PhoneHtml: $cells.eq(4).html(),
                StatusHtml: $cells.eq(5).html(),
                AddedHtml: $cells.eq(6).html(),
                ActionsHtml: $cells.eq(7).html()
            };
        }).get();

        $source.parent().remove();
        window.gtxAdminGridState = window.gtxAdminGridState || {};

        const $grid = $("#employeesAddGrid");
        $grid.addGrid({
            data: rows,
            columns: [
                { field: "PhotoState", title: "Photo", width: 110, filterable: false, searchable: false, template: "#employee-grid-photo-template" },
                { field: "Name", title: "Name", width: 190, filterable: false, searchable: true, searchField: "SearchText", template: "#employee-grid-name-template" },
                { field: "Position", title: "Position", width: 150, searchable: false, template: "#employee-grid-position-template" },
                { field: "Email", title: "Email", width: 220, filterable: false, searchable: false, template: "#employee-grid-email-template" },
                { field: "Phone", title: "Phone", width: 150, filterable: false, searchable: false, template: "#employee-grid-phone-template" },
                { field: "Status", title: "Status", width: 120, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#employee-grid-status-template" },
                { field: "Added", title: "Added", width: 130, filterable: false, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#employee-grid-added-template" },
                { field: "Actions", title: "Actions", width: 120, filterable: false, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#employee-grid-actions-template" }
            ],
            tableClass: "table align-middle m-0",
            height: null,
            pageable: false,
            showRecordCount: true,
            recordType: { singular: "employee", plural: "employees", icon: "bi bi-people-fill" },
            sortable: false,
            filterable: true,
            resizable: false,
            reorderable: false,
            searchable: true,
            showSearch: true,
            searchTerm: window.gtxAdminGridState.employeesSearch || "",
            searchPlaceholder: "Search name, email, or phone…",
            showFilterChips: true,
            exportToExcel: false,
            exportToPdf: false,
            groupable: false,
            alternateRows: true,
            emptyText: "No employees match the current filters.",
            emptyHint: "Adjust the search or column filters to see more employees.",
            onSearchChange: function (detail) {
                window.gtxAdminGridState.employeesSearch = detail.term || "";
            }
        });

        const $newButton = $("#newEmployee").detach().addClass("btn-sm");
        $grid.find(".pg-search-input-group").after($newButton);
        $grid.closest(".shadow").children(".card-header").remove();
    });
</script>
