<section id="gtxChatCommandGuide"
         class="gtx-chat-command-guide"
         aria-label="Chat command guide"
         role="dialog"
         hidden>
    <header class="gtx-chat-command-guide-header">
        <div>
            <strong>What can I ask?</strong>
            <div>Choose an example or type a similar request.</div>
        </div>
        <button type="button" class="gtx-chat-icon-button gtx-chat-guide-close" data-chat-help-close aria-label="Close command guide">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </header>

    <div class="gtx-chat-command-guide-list">
        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="What Honda vehicles are available under $20,000?">
                &quot;What Honda vehicles are available under $20,000?&quot;
            </button>
            <span><i class="bi bi-search" aria-hidden="true"></i> Searches live inventory and shows matching vehicle cards.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="Take me to the inventory for Honda under 2020">
                &quot;Take me to the inventory for Honda under 2020&quot;
            </button>
            <span><i class="bi bi-funnel" aria-hidden="true"></i> Opens inventory filtered to Honda models from 2019 or earlier.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="Show me SUVs under $20,000">
                &quot;Show me SUVs under $20,000&quot;
            </button>
            <span><i class="bi bi-car-front" aria-hidden="true"></i> Opens the SUV inventory with a maximum-price filter.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="What are your hours Saturday?">
                &quot;What are your hours Saturday?&quot;
            </button>
            <span><i class="bi bi-clock" aria-hidden="true"></i> Checks the dealership schedule.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="Take me to the financing application">
                &quot;Take me to the financing application&quot;
            </button>
            <span><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Opens a supported website page.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-prompt="Open this vehicle">
                &quot;Open this vehicle&quot;
            </button>
            <span><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Opens the vehicle when the latest result contains one match.</span>
        </div>

        <div class="gtx-chat-command-guide-item">
            <button type="button" data-chat-contact>
                &quot;Contact sales&quot;
            </button>
            <span><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Opens the sales contact form.</span>
        </div>
    </div>

    <footer class="gtx-chat-command-guide-tip">
        <i class="bi bi-arrow-up-down" aria-hidden="true"></i>
        Use the Up and Down arrow keys in the message box to browse your last 20 requests.
    </footer>
</section>
