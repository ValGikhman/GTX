@model List<GTX.Models.AnnouncementModel>
<link href="~/Content/majordome.css?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/majordome.css")).Ticks)" rel="stylesheet" />

<div class="shadow rounded-4 overflow-hidden">

    <div class="card-header bg-white p-3 border-0 sticky-top" style="z-index: 1020;">
        <div class="d-flex align-items-center justify-content-end">
            <a id="newAnnouncement"
               class="btn btn-gradient"
               data-announcement-modal="true"
               data-title="New Announcement"
               href="@Url.Action("Create", "Announcements")">
                <i class="bi bi-plus-lg me-1"></i> New
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <div id="announcementsAddGrid" class="gtx-admin-add-grid"></div>
        <div class="d-none" aria-hidden="true">
            <table id="anTableSource">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:160px;">Title</th>
                        <th style="width:120px;">Display</th>
                        <th style="width:120px;">Type</th>
                        <th style="min-width:170px;">Date Range</th>
                        <th style="width:120px;">Active</th>
                        <th class="text-end" style="width:260px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-4 text-muted">
                                No announcements yet. Click <strong>New</strong> to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var announcement in Model)
                        {
                            <tr data-grid-row="true"
                                data-active="@(announcement.Active ? "1" : "0")"
                                data-message="@(announcement.MessageHtml ?? string.Empty)">
                                <td>
                                    <div class="fw-semibold">@announcement.Title</div>

                                    @if (announcement.TargetMode.HasValue || !string.IsNullOrWhiteSpace(announcement.TargetValue))
                                    {
                                        <div class="text-muted small">
                                            Target:
                                            @(announcement.TargetMode.HasValue ? announcement.TargetMode.Value.ToString() : "N/A")
                                            @if (!string.IsNullOrWhiteSpace(announcement.TargetValue))
                                            {
                                                <span class="ms-1">(@announcement.TargetValue)</span>
                                            }
                                        </div>
                                    }
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border shadow">
                                        @(announcement.DisplayMode == GTX.Models.DisplayMode.BannerTop ? "Banner" : "Popup")
                                    </span>
                                </td>

                                <td>
                                    @{
                                        var typeText = announcement.Type == GTX.Models.AnnouncementType.Success ? "Success"
                                                    : announcement.Type == GTX.Models.AnnouncementType.Warning ? "Warning"
                                                    : announcement.Type == GTX.Models.AnnouncementType.Danger ? "Danger"
                                                    : announcement.Type == GTX.Models.AnnouncementType.Promo ? "Promo"
                                                    : "Info";

                                        var badgeClass = announcement.Type == GTX.Models.AnnouncementType.Success ? "bg-success-subtle text-success border border-success-subtle shadow"
                                                      : announcement.Type == GTX.Models.AnnouncementType.Warning ? "bg-warning-subtle text-warning border border-warning-subtle shadow"
                                                      : announcement.Type == GTX.Models.AnnouncementType.Danger ? "bg-danger-subtle text-danger border border-danger-subtle shadow"
                                                      : announcement.Type == GTX.Models.AnnouncementType.Promo ? "bg-primary-subtle text-primary border border-primary-subtle shadow"
                                                      : "bg-secondary-subtle text-secondary border border-secondary-subtle";
                                    }

                                    <span class="badge rounded-pill @badgeClass">
                                        @typeText
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @announcement.DateStart.ToString("yyyy-MM-dd")
                                    <span class="mx-1">→</span>
                                    @announcement.DateEnd.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @if (announcement.Active)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle shadow">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle shadow">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        @if (announcement.DisplayMode == GTX.Models.DisplayMode.Popup)
                                        {
                                            <button type="button" class="btn btn-gradient-grey btn-sm btn-outline-success shadow"
                                                    onclick="previewAnnouncementPopup(@announcement.Id)" title="Preview">
                                                <i class="bi bi-eye me-1"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-gradient-grey btn-sm btn-outline-success shadow"
                                                    onclick="previewAnnouncementBanner(@announcement.Id)" title="Preview">
                                                <i class="bi bi-eye me-1"></i>
                                            </button>
                                        }

                                        <a class="btn btn-gradient-grey btn-sm btn-outline-primary shadow"
                                           data-announcement-modal="true"
                                           data-title="Edit Announcement"
                                           href="@Url.Action("Edit", "Announcements", new { id = announcement.Id })">
                                            <i class="bi bi-pencil-square me-1"></i>
                                        </a>

                                        <button id="btnDelete-@announcement.Id"
                                                type="button"
                                                class="btn btn-gradient-grey btn-sm btn-outline-danger shadow"
                                                onclick="deleteAnnouncement(@announcement.Id)"
                                                data-id="@announcement.Id"
                                                title="Delete">
                                            <i class="bi bi-trash me-1"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>

<script type="text/x-addgrid-template" id="announcement-grid-title-template">{{TitleHtml}}</script>
<script type="text/x-addgrid-template" id="announcement-grid-display-template">{{DisplayHtml}}</script>
<script type="text/x-addgrid-template" id="announcement-grid-type-template">{{TypeHtml}}</script>
<script type="text/x-addgrid-template" id="announcement-grid-date-template">{{DateHtml}}</script>
<script type="text/x-addgrid-template" id="announcement-grid-active-template">{{ActiveHtml}}</script>
<script type="text/x-addgrid-template" id="announcement-grid-actions-template">{{ActionsHtml}}</script>

<script>
    $(document).on("click", "[data-close-announcement-preview='true']", function (e) {
        e.preventDefault();
        e.stopPropagation();

        const $host = $("#announcementPreviewHost");
        $host.empty();

        // if you want it to disappear too (recommended)
        $host.closest(".toast-container").hide();
    });

    async function deleteAnnouncement(id) {
        if (!id) return;
        const confirmed = await window.gtxConfirm({
            title: "Delete announcement",
            message: "Delete this announcement? This cannot be undone.",
            confirmText: "Delete",
            variant: "danger"
        });
        if (!confirmed) return;

        $.post(root + "Announcements/Delete", { id: id })
            .done(function (res) {
                if (res && res.ok === true) {
                    refreshList();
                    return;
                }
                window.gtxAlert("Delete failed.");
            })
            .fail(function (xhr) {
                window.gtxAlert("Delete failed. Status: " + xhr.status);
            });
    }

    function refreshList() {
        var $grid = $("#announcementsAddGrid");
        window.gtxAdminGridState = window.gtxAdminGridState || {};
        window.gtxAdminGridState.announcementsSearch = $grid.data("add-grid")
            ? $grid.addGrid("getSearch")
            : (window.gtxAdminGridState.announcementsSearch || "");
        const listContainerSelector = "#tab-announcement";

        $(listContainerSelector).load(`${root}Announcements/ListPartial`);
    }

    $(function initializeAnnouncementsAddGrid() {
        const $source = $("#anTableSource");
        const rows = $source.find("tbody tr[data-grid-row='true']").map(function () {
            const $row = $(this);
            const $cells = $row.children("td");
            const title = $.trim($cells.eq(0).text());
            const display = $.trim($cells.eq(1).text());
            const type = $.trim($cells.eq(2).text());
            const date = $.trim($cells.eq(3).text()).replace(/\s+/g, " ");
            const active = $.trim($cells.eq(4).text());
            const message = $.trim($row.attr("data-message") || "").replace(/<[^>]*>/g, " ");

            return {
                Title: title,
                Display: display,
                Type: type,
                DateRange: date,
                Active: active,
                SearchText: [title, message, display, type, date, active].join(" "),
                TitleHtml: $cells.eq(0).html(),
                DisplayHtml: $cells.eq(1).html(),
                TypeHtml: $cells.eq(2).html(),
                DateHtml: $cells.eq(3).html(),
                ActiveHtml: $cells.eq(4).html(),
                ActionsHtml: $cells.eq(5).html()
            };
        }).get();

        $source.parent().remove();
        window.gtxAdminGridState = window.gtxAdminGridState || {};

        const $grid = $("#announcementsAddGrid");
        $grid.addGrid({
            data: rows,
            columns: [
                { field: "Title", title: "Title", width: 220, filterable: false, searchable: true, searchField: "SearchText", template: "#announcement-grid-title-template" },
                { field: "Display", title: "Display", width: 120, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#announcement-grid-display-template" },
                { field: "Type", title: "Type", width: 120, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#announcement-grid-type-template" },
                { field: "DateRange", title: "Date Range", width: 190, filterable: false, searchable: false, headerClass: "text-center", cellClass: "text-center text-muted", template: "#announcement-grid-date-template" },
                { field: "Active", title: "Active", width: 120, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#announcement-grid-active-template" },
                { field: "Actions", title: "Actions", width: 180, filterable: false, searchable: false, headerClass: "text-center", cellClass: "text-center", template: "#announcement-grid-actions-template" }
            ],
            tableClass: "table align-middle m-0",
            height: null,
            pageable: false,
            showRecordCount: true,
            recordType: { singular: "announcement", plural: "announcements", icon: "bi bi-megaphone-fill" },
            sortable: false,
            filterable: true,
            resizable: false,
            reorderable: false,
            searchable: true,
            showSearch: true,
            searchTerm: window.gtxAdminGridState.announcementsSearch || "",
            searchPlaceholder: "Search title or message…",
            showFilterChips: true,
            exportToExcel: false,
            exportToPdf: false,
            groupable: false,
            alternateRows: true,
            emptyText: "No announcements match the current filters.",
            emptyHint: "Adjust the search or column filters to see more alerts.",
            onSearchChange: function (detail) {
                window.gtxAdminGridState.announcementsSearch = detail.term || "";
            }
        });

        const $newButton = $("#newAnnouncement").detach().addClass("btn-sm");
        $grid.find(".pg-search-input-group").after($newButton);
        $grid.closest(".shadow").children(".card-header").remove();
    });
</script>

