@using System.Linq
@{
    var siteProfile = GTX.SiteProfileStore.Current;
    var profileDirectionsUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(siteProfile.FullAddress);
    var profileMapUrl = "https://www.google.com/maps?q=" + Uri.EscapeDataString(siteProfile.FullAddress) + "&output=embed";
    var openHours = siteProfile.GetOpenHours();
    var now = DateTime.Now;
    var todayName = now.DayOfWeek.ToString();
    var todayHours = openHours.FirstOrDefault(open => string.Equals(open.Day, todayName, StringComparison.OrdinalIgnoreCase));
    var isOpenNow = todayHours != null && todayHours.IsOpenAt(now);
}

<div class="open-hours-panel">
    <section class="open-hours-visual" aria-label="@siteProfile.CompanyName showroom">
        <div class="open-hours-photo-wrap">
            <img class="open-hours-photo" src="@SiteImageUrl.Build("gtx.jpg")" alt="@siteProfile.CompanyName showroom" loading="lazy" decoding="async">
            <div class="open-hours-photo-shade" aria-hidden="true"></div>
            <div class="open-hours-photo-copy">
                <span class="open-hours-kicker">@siteProfile.City, @siteProfile.State</span>
                <h2>Come by.<br>Take your time.</h2>
                <p>See the vehicle in person and meet the people who know it best.</p>
            </div>
            <div class="open-hours-live-status @(isOpenNow ? "is-open" : "is-closed")">
                <span class="open-hours-live-dot" aria-hidden="true"></span>
                <span>
                    <small>Right now</small>
                    <strong>@(isOpenNow ? "We’re open" : "We’re closed")</strong>
                </span>
            </div>
        </div>

        <div class="open-hours-map-wrap">
            <iframe loading="lazy"
                    allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade"
                    src="@profileMapUrl"
                    class="open-hours-map"
                    title="Map to @siteProfile.CompanyName">
            </iframe>
        </div>
    </section>

    <section class="open-hours-content" aria-labelledby="openHoursWeekTitle">
        <header class="open-hours-content-heading">
            <span>
                <small>Plan your visit</small>
                <h3 id="openHoursWeekTitle">This week at GTX</h3>
            </span>
            @if (todayHours != null)
            {
                <span class="open-hours-today-summary">
                    <small>Today</small>
                    <strong>@todayHours.Description</strong>
                </span>
            }
        </header>

        <div class="open-hours-days" role="list" aria-label="Weekly opening hours">
            @foreach (var open in openHours)
            {
                var isToday = string.Equals(open.Day, todayName, StringComparison.OrdinalIgnoreCase);
                <div class="open-hours-day-row @(isToday ? "is-today" : string.Empty)" role="listitem">
                    <span class="open-hours-day-marker" aria-hidden="true"></span>
                    <span class="open-hours-day-name">
                        @open.Day
                        @if (isToday)
                        {
                            <small>Today</small>
                        }
                    </span>
                    <strong class="open-hours-day-hours">@open.Description</strong>
                </div>
            }
        </div>

        <div class="open-hours-visit-card">
            <span class="open-hours-location-icon" aria-hidden="true"><i class="bi bi-geo-alt-fill"></i></span>
            <span class="open-hours-address-text">
                <small>Our showroom</small>
                <strong>@siteProfile.StreetAddress</strong>
                @if (!string.IsNullOrWhiteSpace(siteProfile.AddressLine2)) {
                    <span>@siteProfile.AddressLine2</span>
                }
                <span>@siteProfile.City, @siteProfile.State @siteProfile.ZipCode</span>
            </span>
            <button type="button"
                    class="open-hours-copy-address mobile-menu-copy-address"
                    data-copy-address="@siteProfile.FullAddress"
                    aria-label="Copy address">
                <i class="bi bi-copy" aria-hidden="true"></i>
                <span>Copy</span>
            </button>
        </div>

        <div class="open-hours-actions">
            <a class="open-hours-action open-hours-action-call" href="@siteProfile.PhoneUri">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                <span><small>Questions?</small><strong>@siteProfile.Phone</strong></span>
            </a>
            <a class="open-hours-action open-hours-action-directions"
               href="@profileDirectionsUrl"
               target="_blank"
               rel="noopener noreferrer">
                <i class="bi bi-sign-turn-right-fill" aria-hidden="true"></i>
                <span><small>Ready to go?</small><strong>Get directions</strong></span>
            </a>
        </div>

        <p class="open-hours-footnote"><i class="bi bi-info-circle" aria-hidden="true"></i> Holiday hours may vary. A quick call before your visit is always welcome.</p>
    </section>
</div>
