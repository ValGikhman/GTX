@model GTX.Models.BaseModel

@helper FilterPanel(string panelId, string title, string icon, string field, string[] values, string emptyText = null)
{
    var safeValues = (values ?? new string[0])
        .Where(v => !string.IsNullOrWhiteSpace(v))
        .Distinct()
        .OrderBy(v => v)
        .ToArray();

    if (safeValues.Length == 0)
    {
        return;
    }

    <section class="inventory-filter-panel" data-filter-panel-field="@field">
        <button class="inventory-filter-panel-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@panelId" aria-expanded="false" aria-controls="@panelId">
            <span class="inventory-filter-panel-title text-shadow-small">
                <i class="bi @icon"></i>
                <span>@title</span>
            </span>
            <span class="inventory-filter-panel-count">@safeValues.Length</span>
        </button>
        @if (!string.IsNullOrWhiteSpace(emptyText))
        {
            <div class="inventory-dependent-empty inventory-dependent-panel-empty" data-empty-panel-for="@field">
                @emptyText
            </div>
        }
        <div id="@panelId" class="collapse">
            <div class="inventory-filter-panel-body">
                @foreach (var value in safeValues)
                {
                    var id = "inv-filter-" + field + "-" + HttpUtility.UrlEncode(value).Replace("%", string.Empty).Replace("+", "-");
                    <label class="inventory-check-row" for="@id">
                        <input class="form-check-input inventory-filter-check"
                               type="checkbox"
                               id="@id"
                               data-field="@field"
                               data-value="@value.ToUpperInvariant()" />
                        <span class="inventory-check-label text-shadow-small">@value</span>
                        <span class="inventory-check-hit shadow" data-count-field="@field" data-count-value="@value.ToUpperInvariant()"></span>
                    </label>
                }
            </div>
        </div>
    </section>
}

@helper RangePanel(string panelId, string title, string icon, string field, decimal min, decimal max, decimal step, string format)
{
    if (max <= 0)
    {
        return;
    }

    var minText = min.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var maxText = max.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var stepText = step.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    <section class="inventory-filter-panel inventory-range-filter"
             data-range-field="@field"
             data-range-min="@minText"
             data-range-max="@maxText"
             data-range-step="@stepText"
             data-range-format="@format">
        <button class="inventory-filter-panel-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@panelId" aria-expanded="false" aria-controls="@panelId">
            <span class="inventory-filter-panel-title text-shadow-small">
                <i class="bi @icon"></i>
                <span>@title</span>
            </span>
        </button>
        <div id="@panelId" class="collapse">
            <div class="inventory-filter-panel-body inventory-range-panel-body">
                <div class="inventory-range-values pb-2">
                    <output class="inventory-range-output" for="@($"{panelId}Min")" data-range-value-label-min="@field"></output>
                    <output class="inventory-range-output" for="@($"{panelId}Max")" data-range-value-label-max="@field"></output>
                </div>
                <div id="@($"{panelId}Slider")" class="inventory-dual-range-slider" data-range-slider></div>
                <input id="@($"{panelId}Min")"
                       class="inventory-range-input inventory-range-min-input"
                       type="hidden"
                       min="@minText"
                       max="@maxText"
                       step="@stepText"
                       value="@minText"
                       data-range-field="@field"
                       data-range-bound="min" />
                <input id="@($"{panelId}Max")"
                       class="inventory-range-input inventory-range-max-input"
                       type="hidden"
                       min="@minText"
                       max="@maxText"
                       step="@stepText"
                       value="@maxText"
                       data-range-field="@field"
                       data-range-bound="max" />
            </div>
        </div>
    </section>
}

@{
    var vehicles = Model.Inventory?.Vehicles ?? Enumerable.Empty<GTX.Models.GTX>();
    var hasServerInventoryFilter = ViewBag.HasServerInventoryFilter == true;
    var yearValues = vehicles.Select(v => (decimal)v.Year).ToArray();
    var mileValues = vehicles.Select(v => (decimal)v.Mileage).ToArray();
    var priceValues = vehicles.Select(v => Convert.ToDecimal(v.InternetPrice)).ToArray();

    var minYear = yearValues.Any() ? yearValues.Min() : 0;
    var maxYear = yearValues.Any() ? yearValues.Max() : 0;
    var minMiles = mileValues.Any() ? Math.Floor(mileValues.Min() / 1000m) * 1000m : 0;
    var maxMiles = mileValues.Any() ? Math.Ceiling(mileValues.Max() / 1000m) * 1000m : 0;
    var minPrice = priceValues.Any() ? Math.Floor(priceValues.Min() / 1000m) * 1000m : 0;
    var maxPrice = priceValues.Any() ? Math.Ceiling(priceValues.Max() / 1000m) * 1000m : 0;
}

<aside id="inventoryFilterRail" class="inventory-filter-rail">
    <div class="inventory-filter-shell">
        <div class="inventory-filter-scroll">
            <div class="inventory-filter-stats sticky-top">
                <button type="button" id="inventorySidebarDockToggle" class="btn btn-sm btn-gradient-grey border-secondary-subtle rounded-3 shadow-sm fw-bold inventory-clear-btn d-none d-lg-inline-flex" title="Dock filters on right" aria-label="Dock filters on right">
                    <i class="bi bi-layout-sidebar-reverse"></i>
                </button>
                <div class="inventory-filter-match">
                    <span id="inventoryFilterCount" class="flex-shrink-0">0</span>
                    <span class="text-truncate">matching vehicle(s)</span>
                </div>
                <button type="button" id="inventoryClearFiltersDesktop" class="btn btn-sm btn-gradient-grey border-secondary-subtle rounded-3 shadow-sm fw-bold inventory-clear-btn d-none d-lg-inline-flex light-gradient-action"
                        title="@(hasServerInventoryFilter ? "Reset search results — show all inventory" : "Clear filters")"
                        aria-label="@(hasServerInventoryFilter ? "Reset search results — show all inventory" : "Clear filters")">
                    <i class="bi @(hasServerInventoryFilter ? "bi-arrow-counterclockwise" : "bi-eraser-fill")" aria-hidden="true"></i>
                    @if (hasServerInventoryFilter)
                    {
                        <span>Reset</span>
                    }
                </button>
                <button type="button" id="inventoryMobileCloseCanvas" class="btn btn-sm btn-gradient-grey border-secondary-subtle rounded-3 shadow-sm fw-bold inventory-clear-btn d-lg-none">
                    <i class="bi bi-binoculars"></i>
                    <span>Search</span>
                </button>
            </div>

            @RangePanel("invFilterYearRange", I18n.R("All_Year"), "bi-calendar3", "year", minYear, maxYear, 1m, "year")
            @FilterPanel("invFilterMakes", I18n.R("All_Makes"), "bi-building", "make", Model.Filters?.Makes)
            @FilterPanel("invFilterModels", I18n.R("All_Models"), "bi-car-front", "model", Model.Filters?.Models, "Choose a make to see available models.")
            @FilterPanel("invFilterBody", I18n.R("All_Body"), "bi-truck-front", "body", Model.Filters?.BodyTypes)
            @FilterPanel("invFilterType", I18n.R("All_Type"), "bi-car-front-fill", "type", Model.Filters?.VehicleTypes)
            @FilterPanel("invFilterFuel", I18n.R("All_Fuel"), "bi-fuel-pump", "fuel", Model.Filters?.FuelTypes)
            @FilterPanel("invFilterDrive", I18n.R("All_Drive"), "bi-gear", "drive", Model.Filters?.DriveTrains)
            @FilterPanel("invFilterTransmission", I18n.R("All_Transm"), "bi-shuffle", "transmission", Model.Filters?.Transmissions)
            @FilterPanel("invFilterCylinders", I18n.R("All_Cylinders"), "bi-speedometer", "cylinders", Model.Filters?.Cylinders)
            @RangePanel("invFilterMilesRange", I18n.R("All_Miles"), "bi-speedometer2", "miles", minMiles, maxMiles, 1000m, "number")
            @RangePanel("invFilterPriceRange", I18n.R("All_Price"), "bi-currency-dollar", "price", minPrice, maxPrice, 1000m, "currency")
        </div>
    </div>
</aside>

<style>
    .inventory-split {
        --inventory-sidebar-width: 340px;
        display: flex;
        align-items: stretch;
        gap: 0;
        height: 100%;
        min-height: 0;
        margin-left: 0 !important;
        padding-left: 0 !important;
    }

    .inventory-sidebar-pane {
        width: var(--inventory-sidebar-width);
        flex: 0 0 var(--inventory-sidebar-width);
        min-width: 260px;
        max-width: 520px;
        height: 100%;
        min-height: 0;
        margin-left: 0;
        padding-left: 0;
        transition: flex-basis .18s ease, width .18s ease, opacity .18s ease;
    }

    #inventorySidebarPane .inventory-filter-offcanvas-body {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .inventory-filter-rail {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        overflow: hidden;
        position: relative;
        z-index: 4;
        margin-left: 0;
        padding-left: 0;
    }

    .inventory-filter-shell {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        max-height: 95%;
        min-height: 0;
        overflow: hidden;
        background: var(--gtx-page-bg, ghostwhite);
    }

    .inventory-split-divider {
        position: relative;
        height: 100%;
        min-height: 0;
        box-sizing: border-box;
        left: 15px;
        opacity: 1;
        cursor: col-resize;
        touch-action: none;
    }

    .inventory-split-divider::before {
        content: "";
        position: absolute;
        top: .75rem;
        bottom: .75rem;
        left: 50%;
        width: 2px;
        transform: translateX(-50%);
        border-radius: 999px;
        background: rgba(255, 255, 255, .32);
        box-shadow: 0 0 0 1px rgba(0, 0, 0, .18), 0 10px 24px rgba(15, 23, 42, .16);
        transition: width .15s ease, box-shadow .15s ease, opacity .15s ease;
    }

    .inventory-split-divider::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: .2rem;
        height: 3.25rem;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background-image: radial-gradient(circle, rgba(255, 255, 255, .72) 1.5px, transparent 2px);
        background-size: .2rem .55rem;
        background-position: center;
        opacity: .92;
        pointer-events: none;
    }

    .inventory-split-divider:hover::before,
    body.inventory-split-resizing .inventory-split-divider::before {
        width: 4px;
    }

    .inventory-sidebar-toggle {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 2;
        width: 1.65rem;
        height: 1.65rem;
        padding: 0;
        transform: translate(-50%, -50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .inventory-sidebar-toggle:hover,
    .inventory-sidebar-toggle:focus {
        transform: translate(-50%, -50%) scale(1.06);
        box-shadow: 0 12px 26px rgba(15, 23, 42, .28) !important;
    }

    .inventory-sidebar-collapsed .inventory-sidebar-pane {
        width: 0;
        flex-basis: 0;
        min-width: 0;
        overflow: hidden;
        opacity: 0;
    }

    @@media (min-width: 992px) {
        .inventory-sidebar-right .inventory-results-zone {
            order: 1;
        }

        .inventory-sidebar-right .inventory-split-divider {
            left: -15px;
            order: 2;
        }

        .inventory-sidebar-right .inventory-sidebar-pane {
            order: 3;
        }
    }

    body.inventory-split-resizing,
    body.inventory-split-resizing * {
        cursor: col-resize !important;
        user-select: none !important;
    }

    .inventory-filter-stats {
        --inventory-stats-accent: var(--gtx-accent-solid, #155a96);
        display: grid;
        grid-template-columns: minmax(min-content, 1fr) minmax(0, max-content) minmax(min-content, 1fr);
        align-items: center;
        column-gap: .2rem;
        min-block-size: calc(var(--inventory-filter-row-height) + 2px);
        padding: .2rem .3rem;
        border: 1px solid rgba(115, 125, 140, .3);
        border-inline-start: .2rem solid var(--inventory-stats-accent);
        color: var(--gtx-menu-ink);
        box-shadow: 0 .2rem .55rem rgba(15, 23, 42, .13);
    }

    .inventory-filter-match {
        display: inline-flex;
        grid-column: 2;
        align-items: center;
        gap: .4rem;
        min-width: 0;
        font-size: .84rem;
        font-weight: 700;
        white-space: nowrap;
    }

    #inventoryFilterCount {
        display: inline-grid;
        place-items: center;
        min-inline-size: 2.2rem;
        min-block-size: 1.7rem;
        padding-inline: .4rem;
        font-size: .92rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .inventory-clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        line-height: 1.2;
    }

    .inventory-filter-stats > .inventory-clear-btn {
        grid-column: 3;
        justify-self: end;
        min-inline-size: 2rem;
        min-block-size: 2rem;
        white-space: nowrap;
    }

    .inventory-filter-stats > #inventorySidebarDockToggle {
        grid-column: 1;
        justify-self: start;
    }

    .inventory-filter-stats.sticky-top > .inventory-clear-btn:focus-visible {
        outline: 2px solid var(--gtx-menu-ink);
        outline-offset: 2px;
    }

    .inventory-filter-scroll {
        height: 0;
    }

    .inventory-filter-scroll.is-scrollable {
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        touch-action: pan-y;
    }

    #inventorySidebarPane .inventory-filter-scroll {
        --inventory-filter-inset: .55rem;
        padding: var(--inventory-filter-inset);
        scroll-padding-block-start: calc(var(--inventory-filter-row-height) + .5rem + 2px);
        scroll-padding-bottom: .55rem;
    }

    .inventory-filter-stats {
        margin-bottom: .5rem;
        border-radius: .5rem;
    }

    .inventory-range-panel-body {
        padding-top: .45rem;
    }

    .inventory-range-values {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .4rem;
        margin-bottom: .35rem;
        color: #1f2937;
        font-size: .72rem;
        font-weight: 900;
    }

    .inventory-range-separator {
        display: none;
        flex: 0 0 auto;
        color: #6b7280;
    }

    .inventory-range-output {
        flex: 1 1 0;
        min-width: 0;
        max-width: 6.4rem;
        padding: .08rem .32rem;
        border-radius: .38rem;
        color: #1f2937;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .inventory-range-output:first-of-type {
        text-align: left;
    }

    .inventory-range-output:last-of-type {
        text-align: right;
    }

    .inventory-range-input {
        display: none;
    }

    .inventory-dual-range-slider {
        min-height: 6px;
        margin: .05rem .28rem 0;
        touch-action: none;
    }

    .inventory-dual-range-slider.noUi-target {
        height: 2px;
        border: 1px solid rgba(15, 23, 42, .14);
        border-radius: 999px;
        background: #e5e7eb;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, .12);
    }

    .inventory-dual-range-slider .noUi-connect {
        background: #155a96;
    }

    .inventory-dual-range-slider .noUi-handle {
        width: 18px;
        height: 18px;
        right: -9px;
        top: -9px;
        border-radius: 999px;
        border: 1px solid rgba(15, 23, 42, .22);
        background: linear-gradient(180deg, #ffffff, #e5e7eb);
        box-shadow: 0 1px 4px rgba(15, 23, 42, .28);
        cursor: pointer;
        touch-action: none;
    }

    .inventory-dual-range-slider .noUi-handle::before,
    .inventory-dual-range-slider .noUi-handle::after {
        display: none;
    }

    .inventory-dual-range-slider .noUi-touch-area {
        width: 100%;
        height: 100%;
    }

    html.theme-grey .inventory-dual-range-slider .noUi-connect,
    html.theme-black .inventory-dual-range-slider .noUi-connect {
        background-color: #757575;
    }

    html.theme-navy .inventory-dual-range-slider .noUi-connect {
        background-color: #245f96;
    }

    html.theme-green .inventory-dual-range-slider .noUi-connect {
        background-color: #23875d;
    }

    html.theme-red .inventory-dual-range-slider .noUi-connect {
        background-color: #b83246;
    }

    .inventory-check-row {
        cursor: pointer;
        color: #1f2937;
    }

    .form-check-input.inventory-filter-check {
        --inventory-check-accent: var(--gtx-accent-solid, #155a96);
        flex: 0 0 auto;
        width: max(20px, 1.25rem);
        height: max(20px, 1.25rem);
        margin: 0;
        border-color: var(--bs-secondary-color, #6b7280);
        border-radius: .4rem;
        background-image: var(--bs-form-check-bg-image, none), linear-gradient(165deg, rgba(255, 255, 255, .18), rgba(0, 0, 0, .08));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .25), 0 1px 2px rgba(0, 0, 0, .16);
        cursor: pointer;
    }

    .inventory-check-row .form-check-input.inventory-filter-check:is(:checked, :indeterminate) {
        background-color: var(--inventory-check-accent);
        background-color: color-mix(in srgb, var(--inventory-check-accent) 82%, black);
        border-color: var(--inventory-check-accent);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 0 0 2px color-mix(in srgb, var(--inventory-check-accent) 28%, transparent);
    }

    .inventory-check-row:hover .inventory-filter-check:not(:disabled),
    .form-check-input.inventory-filter-check:focus-visible {
        border-color: var(--inventory-check-accent);
        border-color: color-mix(in srgb, var(--inventory-check-accent) 52%, var(--bs-body-color, #212529));
    }

    .form-check-input.inventory-filter-check:focus-visible {
        outline: 2px solid var(--bs-body-color, #212529);
        outline-offset: 2px;
    }

    @@media (prefers-reduced-motion: no-preference) {
        .form-check-input.inventory-filter-check {
            transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
    }

    @@media (forced-colors: active) {
        .form-check-input.inventory-filter-check {
            appearance: auto;
        }
    }

    .inventory-check-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .inventory-dependent-empty {
        margin: .35rem .2rem;
        padding: .65rem .7rem;
        border-radius: .45rem;
        color: #6b7280;
        font-size: .82rem;
        font-weight: 800;
        text-align: center;
    }

    .inventory-results-zone {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        min-width: 0;
        flex: 1 1 auto;
    }

    .inventory-results-zone #inventory > .card {
        height: auto;
        align-self: flex-start;
    }

    .inventory-empty-filter {
        display: none;
        border: 1px dashed rgba(0, 0, 0, .2);
        border-radius: .5rem;
        background: #fff;
        color: #4b5563;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .inventory-layout,
        .inventory-split {
            flex-direction: column;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .inventory-sidebar-pane {
            width: 100%;
            flex-basis: auto;
            max-width: none;
            height: auto;
            min-width: 0;
            opacity: 1;
        }

        .inventory-sidebar-collapsed .inventory-sidebar-pane {
            width: 100%;
            flex-basis: auto;
            min-width: 0;
            opacity: 1;
        }

        .inventory-filter-rail {
            width: 100%;
            height: 100%;
            max-height: 100%;
            min-height: 0;
        }

        .inventory-filter-shell {
            height: 100%;
            max-height: 100%;
        }

        .inventory-split-divider {
            display: none;
        }

        .inventory-filter-scroll {
            height: 0;
            max-height: none;
            padding-bottom: calc(.75rem + env(safe-area-inset-bottom));
            scroll-padding-bottom: calc(.75rem + env(safe-area-inset-bottom));
        }

        #inventorySidebarPane .inventory-filter-scroll {
            --inventory-filter-inset: .7rem;
            padding-bottom: calc(.75rem + env(safe-area-inset-bottom));
            scroll-padding-bottom: calc(.75rem + env(safe-area-inset-bottom));
        }

        .inventory-results-zone {
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .inventory-results-zone #inventory {
            overflow-y: auto;
        }

    }
</style>
