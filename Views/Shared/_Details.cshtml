@using System
@using System.Linq
@model GTX.Models.BaseModel

@{
    var vehicle = Model != null && Model.CurrentVehicle != null
        ? Model.CurrentVehicle.VehicleDetails
        : null;
}

@if (vehicle == null)
{
    <div class="alert alert-warning mb-3" role="alert">
        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Vehicle details are not available.
    </div>
}
else
{
    var vehicleTitle = string.Join(" ", new[]
    {
        vehicle.Year > 0 ? vehicle.Year.ToString() : null,
        vehicle.Make,
        vehicle.Model,
        vehicle.VehicleStyle
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    var transmission = string.IsNullOrWhiteSpace(vehicle.Transmission)
        ? "Not specified"
        : vehicle.Transmission + (vehicle.TransmissionSpeed > 0 ? " · " + vehicle.TransmissionSpeed + "-speed" : string.Empty);
    var features = (vehicle.Features ?? string.Empty)
        .Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(feature => feature.Trim())
        .Where(feature => feature.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    <section class="gtx-vehicle-overview well mb-3" aria-labelledby="vehicleOverviewTitle">
        <button class="gtx-overview-toggle w-100 btn btn-gradient position-relative collapse-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#details"
                aria-expanded="true"
                aria-controls="details">
            <span class="gtx-overview-toggle-copy">
                <span class="gtx-overview-toggle-icon" aria-hidden="true"><i class="bi bi-car-front-fill"></i></span>
                <span>
                    <small>Vehicle profile</small>
                    <strong id="vehicleOverviewTitle">@I18n.R("All_Details")</strong>
                </span>
            </span>
            <span class="toggle-icons" aria-hidden="true">
                <i class="bi bi-plus-lg icon-plus"></i>
                <i class="bi bi-dash-lg icon-minus"></i>
            </span>
        </button>

        <div class="collapse show" id="details">
            <div class="gtx-overview-body">
                <header class="gtx-overview-summary">
                    <div class="gtx-overview-summary-copy">
                        <span class="gtx-overview-kicker">At a glance</span>
                        <h2>@(string.IsNullOrWhiteSpace(vehicleTitle) ? "Vehicle overview" : vehicleTitle)</h2>
                        <div class="gtx-overview-identifiers">
                            @if (!string.IsNullOrWhiteSpace(vehicle.Stock))
                            {
                                <span class="copyable" data-copy-value="@vehicle.Stock" title="Double-click to copy Stock#"><i class="bi bi-upc-scan" aria-hidden="true"></i> Stock @vehicle.Stock</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(vehicle.VIN))
                            {
                                <span class="copyable" data-copy-value="@vehicle.VIN" title="Double-click to copy VIN"><i class="bi bi-fingerprint" aria-hidden="true"></i> @vehicle.VIN</span>
                            }
                        </div>
                    </div>
                </header>

                <div class="gtx-overview-specs" aria-label="Vehicle specifications">
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                        <span><small>Location</small><strong>@(string.IsNullOrWhiteSpace(vehicle.LocationCode) ? "GTX Auto Group" : vehicle.LocationCode)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                        <span><small>Mileage</small><strong>@vehicle.Mileage.ToString("N0") miles</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-cpu" aria-hidden="true"></i></span>
                        <span><small>Engine</small><strong>@(string.IsNullOrWhiteSpace(vehicle.Engine) ? "Not specified" : vehicle.Engine)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-bounding-box" aria-hidden="true"></i></span>
                        <span><small>Body</small><strong>@(string.IsNullOrWhiteSpace(vehicle.Body) ? "Not specified" : vehicle.Body)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                        <span><small>Drivetrain</small><strong>@(string.IsNullOrWhiteSpace(vehicle.DriveTrain) ? "Not specified" : vehicle.DriveTrain)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-car-front" aria-hidden="true"></i></span>
                        <span><small>Vehicle type</small><strong>@(string.IsNullOrWhiteSpace(vehicle.VehicleType) ? "Not specified" : vehicle.VehicleType)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-hexagon" aria-hidden="true"></i></span>
                        <span><small>Cylinders</small><strong>@(vehicle.Cylinders > 0 ? vehicle.Cylinders.ToString() : "Not specified")</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-fuel-pump" aria-hidden="true"></i></span>
                        <span><small>Fuel</small><strong>@(string.IsNullOrWhiteSpace(vehicle.FuelType) ? "Not specified" : vehicle.FuelType)</strong></span>
                    </div>
                    <div class="gtx-overview-spec">
                        <span class="gtx-overview-spec-icon"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></span>
                        <span><small>Transmission</small><strong>@transmission</strong></span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(vehicle.Color) || !string.IsNullOrWhiteSpace(vehicle.Color2))
                {
                    <section class="gtx-overview-colors" aria-labelledby="vehicleColorsTitle">
                        <div class="gtx-overview-section-heading">
                            <span class="gtx-overview-heading-icon"><i class="bi bi-palette" aria-hidden="true"></i></span>
                            <span><small>Finish</small><strong id="vehicleColorsTitle">Vehicle colors</strong></span>
                        </div>
                        <div class="gtx-overview-color-list">
                            @if (!string.IsNullOrWhiteSpace(vehicle.Color))
                            {
                                <div class="gtx-overview-color">
                                    <span class="gtx-overview-color-swatch" style="background-color: @vehicle.Color" aria-hidden="true"></span>
                                    <span><small>Exterior</small><strong>@vehicle.Color</strong></span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(vehicle.Color2))
                            {
                                <div class="gtx-overview-color">
                                    <span class="gtx-overview-color-swatch" style="background-color: @vehicle.Color2" aria-hidden="true"></span>
                                    <span><small>Interior</small><strong>@vehicle.Color2</strong></span>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (features.Length > 0)
                {
                    <section class="gtx-overview-features" aria-labelledby="vehicleFeaturesTitle">
                        <div class="gtx-overview-section-heading">
                            <span class="gtx-overview-heading-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                            <span><small>Equipment</small><strong id="vehicleFeaturesTitle">Features &amp; highlights</strong></span>
                            <span class="gtx-overview-count">@features.Length</span>
                        </div>
                        <div class="gtx-overview-feature-list">
                            @foreach (var feature in features)
                            {
                                <span><i class="bi bi-check2" aria-hidden="true"></i>@feature</span>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </section>
}
