@model GTX.Models.BlogPostModel
@{
    var isEdit = Model != null && Model.Id > 0;
    var action = isEdit ? "Save" : "Create";
    var htmlAttrs = new Dictionary<string, object>
{
        { "data-blog-ajax", "true" }
    };
}
@using (Html.BeginForm(action, "Blogs", FormMethod.Post, htmlAttrs))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.CreatedAt)

    <div class="container-fluid p-0">
        <div class="border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2 text-shadow-small">
                        <i class="bi bi-journal-text fs-4 text-primary"></i>
                        <div>
                            <div class="fw-semibold fs-5 mb-0 text-shadow-small">@(isEdit ? "Edit Post" : "Create Post")</div>
                            <div class="text-muted small">Compose content, attach links, and preview media.</div>
                        </div>
                    </div>

                    <div class="form-check form-switch m-0 text-shadow-small">
                        @Html.CheckBoxFor(m => m.IsPublished, new { @class = "form-check-input", id = "IsPublished" })
                        <label class="form-check-label fw-semibold" for="IsPublished">
                            Published
                        </label>
                    </div>
                </div>
            </div>

            <div class="card-body p-3">
                <div class="row g-4">

                    <!-- Article URL -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-shadow-small">
                            <i class="bi bi-link-45deg me-1 text-primary"></i> Article URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-globe2 text-secondary"></i>
                            </span>
                            @Html.TextBoxFor(m => m.ArticleURL, new { @class = "form-control", type = "url", id = "ArticleUrl", placeholder = "https://example.com/article.html" })
                        </div>
                        <div class="form-text">Paste a direct article link.</div>
                    </div>

                    <!-- Media URL -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-shadow-small" for="MediaUrl">
                            <i class="bi bi-collection-play me-1 text-primary"></i> Image / video URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-camera text-secondary"></i>
                            </span>
                            @Html.TextBoxFor(m => m.MediaURL, new { @class = "form-control", type = "url", id = "MediaUrl", placeholder = "https://example.com/photo.jpg" })
                        </div>
                        <div class="form-text">Paste a direct image link or an MP4, M4V, WebM, or OGV video link.</div>
                    </div>

                    <!-- Preview -->
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-label fw-semibold mb-2 text-shadow-small">
                                <i class="bi bi-eye me-1 text-primary"></i> Media preview
                            </label>
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
                                Live preview
                            </span>
                        </div>

                        <div class="border rounded-4 bg-light shadow-sm overflow-hidden position-relative" style="height:260px;">
                            <img id="imagePreview"
                                 alt="Image preview"
                                 class="w-100 h-100"
                                 style="object-fit:cover;display:none;" />
                            <video id="videoPreview" class="w-100 h-100" controls playsinline preload="metadata"
                                   aria-label="Video preview" style="object-fit:contain;display:none;">
                                <source data-blog-video-source />
                            </video>
                        </div>
                    </div>

                    <hr class="my-1" />

                    <!-- Title -->
                    <div class="col-md-7">
                        <label class="form-label fw-semibold text-shadow-small">
                            <i class="bi-person-badge me-1 text-primary"></i> Title
                        </label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control shadow-sm", maxlength = "200", placeholder = "Post title..." })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Author -->
                    <div class="col-md-5">
                        <label class="form-label fw-semibold text-shadow-small">
                            <i class="bi bi-person-badge me-1 text-primary"></i> Author
                        </label>
                        @Html.TextBoxFor(m => m.Author, new { @class = "form-control shadow-sm", placeholder = "Optional" })
                    </div>

                    <!-- Content -->
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-label fw-semibold mb-2 text-shadow-small">
                                <i class="bi bi-pencil-square me-1 text-primary"></i> Content
                            </label>
                            <span class="text-muted small">
                                <i class="bi bi-lightning-charge me-1"></i> Rich editor enabled
                            </span>
                        </div>

                        <div class="shadow-sm rounded-3 overflow-hidden border">
                            @Html.TextAreaFor(m => m.Content, new { id = "Content", @class = "form-control border-0" })
                        </div>

                        @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger small" })
                    </div>

                    @Html.ValidationSummary(false, "", new { @class = "text-danger mt-2" })

                    <!-- Actions -->
                    <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="btn btn-outline-secondary px-3 shadow" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </button>
                        <button type="submit" class="btn @(isEdit ? "btn-gradient" : "btn-success") px-3 shadow">
                            <i class="bi @(isEdit ? "bi-save" : "bi-plus-circle") me-1"></i> @(isEdit ? "Save Changes" : "Create Post")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        var $form = $('form[data-blog-ajax="true"]');
        if (!$form.length) $form = $('form').first();

        var $contentField = $('#Content', $form);
        $contentField.addEdit({
            height: 260,
            placeholder: 'Write the post content...'
        });
        var contentEditor = $contentField.data('add-edit');

        function normalizeEmpty(html) {
            var h = $.trim(html || '');
            return (h === '<p><br></p>' || h === '<div><br></div>') ? '' : h;
        }

        function syncContent() {
            var html = normalizeEmpty(contentEditor ? contentEditor.value() : $contentField.val());
            $contentField.val(html);
        }

        // Sync on any submit (delegated helps if form is injected)
        $form.on('submit.addEditBlog', syncContent);

        // Extra safety: sync on click (some AJAX serializers grab values on click)
        $form.on('click', 'button[type=submit], input[type=submit]', function () {
            syncContent();
        });

        // -----------------------------
        // Media URL -> image or video preview
        // -----------------------------
        $form.triggerHandler('blog:dispose');
        const imageExtensions = ["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"];
        const videoTypes = { mp4: "video/mp4", m4v: "video/mp4", webm: "video/webm", ogv: "video/ogg" };
        const $mediaInput = $form.find('#MediaUrl');
        const imagePreview = $form.find('#imagePreview').get(0);
        const videoPreview = $form.find('#videoPreview').get(0);
        const videoSource = $form.find('[data-blog-video-source]').get(0);
        let previewUrl = '';
        let previewKind = '';
        let previewTimer = null;

        function describePreview(value) {
            const url = (value || '').trim();
            if (!/^https?:\/\//i.test(url) && !/^\/(?![\/\\])/.test(url)) return null;
            try {
                const parsed = new URL(url, window.location.href);
                if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
                const match = parsed.pathname.toLowerCase().match(/\.([a-z0-9]+)$/);
                const extension = match ? match[1] : '';
                if (imageExtensions.includes(extension)) return { url: url, kind: 'image' };
                if (Object.prototype.hasOwnProperty.call(videoTypes, extension))
                    return { url: url, kind: 'video', contentType: videoTypes[extension] };
            } catch (e) { /* Wait for a complete supported media URL. */ }
            return null;
        }

        function clearMediaPreview(replacingVideo) {
            imagePreview.onerror = null;
            imagePreview.removeAttribute('src');
            imagePreview.style.display = 'none';
            videoPreview.onerror = null;
            videoSource.onerror = null;
            videoPreview.pause();
            const hadSource = videoSource.hasAttribute('src');
            videoSource.removeAttribute('src');
            videoSource.removeAttribute('type');
            videoPreview.style.display = 'none';
            if (hadSource && replacingVideo !== true) videoPreview.load();
            previewUrl = '';
            previewKind = '';
        }

        function renderPreviewFromInputValue(value) {
            const media = describePreview(value);
            if (media && media.url === previewUrl && media.kind === previewKind) return;
            clearMediaPreview(media && media.kind === 'video');
            if (!media) return;

            previewUrl = media.url;
            previewKind = media.kind;
            if (media.kind === 'image') {
                imagePreview.onerror = clearMediaPreview;
                imagePreview.src = media.url;
                imagePreview.style.display = '';
            } else {
                videoPreview.onerror = clearMediaPreview;
                videoSource.onerror = clearMediaPreview;
                videoSource.src = media.url;
                videoSource.type = media.contentType;
                videoPreview.style.display = '';
                videoPreview.load();
            }
        }

        function disposeMediaPreview() {
            window.clearTimeout(previewTimer);
            previewTimer = null;
            $mediaInput.off('.blogMediaPreview');
            $form.off('blog:dispose.blogMediaPreview');
            clearMediaPreview();
        }

        $mediaInput.off('.blogMediaPreview').on('input.blogMediaPreview change.blogMediaPreview', function () {
            window.clearTimeout(previewTimer);
            previewTimer = window.setTimeout(function () {
                previewTimer = null;
                renderPreviewFromInputValue($mediaInput.val());
            }, 250);
        });
        $form.off('blog:dispose.blogMediaPreview').on('blog:dispose.blogMediaPreview', disposeMediaPreview);

        // Initial render (edit mode)
        renderPreviewFromInputValue($mediaInput.val());
        syncContent();
    });
</script>
