@model GTX.Models.AnnouncementModel
@functions {
    private string GetBootstrapAlertClass(GTX.Models.AnnouncementType type)
    {
        switch (type)
        {
            case GTX.Models.AnnouncementType.Success: return "success";
            case GTX.Models.AnnouncementType.Warning: return "warning";
            case GTX.Models.AnnouncementType.Danger: return "danger";
            case GTX.Models.AnnouncementType.Promo: return "primary";
            default: return "info";
        }
    }

    private string GetIcon(GTX.Models.AnnouncementType type)
    {
        switch (type)
        {
            case GTX.Models.AnnouncementType.Success: return "bi-check-circle-fill";
            case GTX.Models.AnnouncementType.Warning: return "bi-exclamation-triangle-fill";
            case GTX.Models.AnnouncementType.Danger: return "bi-x-octagon-fill";
            case GTX.Models.AnnouncementType.Promo: return "bi-megaphone-fill";
            default: return "bi-info-circle-fill";
        }
    }
}

@{
    var siteProfile = GTX.SiteProfileStore.Current;
    var cls = GetBootstrapAlertClass(Model.Type);
    var icon = GetIcon(Model.Type);
}

<style>
    .gtx-announcement {
        --bs-alert-padding-x: clamp(1rem, 3vw, 1.75rem);
        --bs-alert-padding-y: .75rem;
        --bs-gradient: linear-gradient(180deg, transparent, rgba(0,0,0,.16));
        padding-inline: var(--bs-alert-padding-x);
        overflow-wrap: anywhere;
    }

        .gtx-announcement::before {
            content: "";
            position: absolute;
            inset: 0 0 auto;
            height: .25rem;
            pointer-events: none;
            background: linear-gradient(90deg, #b65a2a, #edc16d, #812f27);
        }

        .gtx-announcement .btn-close {
            --bs-btn-close-opacity: .8;
            top: .65rem;
            right: .65rem;
            width: 44px;
            height: 44px;
            padding: 0;
            box-sizing: border-box;
            background-color: var(--bs-body-bg);
        }

        .gtx-announcement .btn-close:is(:hover, :focus-visible) {
            background-color: var(--bs-secondary-bg);
        }

        .gtx-announcement .gtx-announcement-label {
            max-width: calc(100% - 7rem);
        }

        .gtx-announcement .gtx-announcement-title {
            font-size: clamp(1.55rem, 3.5vw, 2.375rem);
            text-wrap: balance;
        }

        .gtx-announcement .gtx-announcement-body :is(h1, h2, h3, h4, h5, h6, p) {
            color: inherit;
        }

        .gtx-announcement .gtx-announcement-body p {
            margin-bottom: .6rem;
        }

        .gtx-announcement .gtx-announcement-body img {
            max-width: 100%;
            max-height: max(10rem, calc(58vh - var(--gtx-announcement-image-inset, 0px)));
            max-height: max(10rem, calc(58dvh - var(--gtx-announcement-image-inset, 0px)));
            height: auto;
            display: block;
            margin: .75rem auto;
            object-fit: contain;
            border-radius: 1rem;
            border: 1px solid #d4a25e;
            padding: .25rem;
            background: #fffcf4;
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.12);
        }
</style>

<div class="alert alert-@cls alert-dismissible fade show shadow-lg rounded-5 mb-0 w-100 text-center gtx-announcement" role="alert">
    <!-- top-right close -->
    <button type="button" class="btn-close rounded-circle border border-secondary-subtle"
            aria-label="Close" data-bs-dismiss="alert"></button>

    <!-- Header -->
    <div class="d-flex flex-column align-items-center gap-2 pt-2">
        <div class="gtx-announcement-label d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill border border-primary shadow-sm text-bg-primary bg-gradient">
            <i class="bi @icon fs-5"></i>
            <span class="fw-semibold text-uppercase small" style="letter-spacing:.08em;">@siteProfile.CompanyName Announcement</span>
        </div>

        <div class="display-6 fw-bold lh-1 mb-1 gtx-announcement-title">
            @Model.Title
        </div>
    </div>

    <!-- Body -->
    <div class="mt-2">
        <div class="mx-auto gtx-announcement-body" style="max-width: 860px;">
            @Html.Raw(SecuritySanitizer.SanitizeRichHtml(Model.MessageHtml))
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-2 pt-2 border-top border-dark border-opacity-10">
        <div class="d-flex justify-content-center small">
            <span class="badge rounded-pill border border-secondary shadow-sm px-3 py-2 text-bg-secondary bg-gradient text-wrap">
                <i class="bi bi-calendar3 me-1"></i>
                @Model.DateStart.ToString("MMM dd, yyyy") - @Model.DateEnd.ToString("MMM dd, yyyy")
            </span>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
            <a href="~/Inventory/All" class="btn btn-primary rounded-pill px-4 shadow-sm bg-gradient">
                <i class="bi bi-search me-2"></i>@I18n.R("All_SearchInventory")
            </a>

            <button type="button" class="btn btn-outline-dark rounded-pill px-4 shadow-sm" data-bs-dismiss="alert">
                <i class="bi bi-x-lg me-2"></i>@I18n.R("All_Close")
            </button>
        </div>
    </div>
</div>

