@model GTX.Models.GTX
@{
    var detailsUrl = Url.Action("Details", "Inventory", new { stock = Model.Stock });
    var adCardImageUrl = InventoryImageUrl.Build(Model.Image, Model.Stock, InventoryImageVariant.Card);
    var adCardTitle = $"{Model.Year} {Model.Make} {Model.Model} {Model.VehicleStyle}".Trim();
    var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var documentaryFee = Model.InternetPrice > 0 ? Constants.DOCUMENTARY_FEE : 0;
    var transparentPrice = Model.InternetPrice + documentaryFee;
    var stockValue = (Model.Stock ?? string.Empty).ToUpperInvariant();
    var makeValue = (Model.Make ?? string.Empty).ToUpperInvariant();
    var modelValue = (Model.Model ?? string.Empty).ToUpperInvariant();
    var styleValue = (Model.VehicleStyle ?? string.Empty).ToUpperInvariant();
    var typeValue = (Model.VehicleType ?? string.Empty).ToUpperInvariant();
}

<div id="@Model.Stock"
     class="gtx-ad-card hover-bw"
     title="Click here to see details."
     data-url="@detailsUrl"
     data-year="@Model.Year"
     data-stock="@stockValue"
     data-make="@makeValue"
     data-model="@modelValue"
     data-style="@styleValue"
     data-type="@typeValue">
    <div class="gtx-ad-card-media">
        <img src="@adCardImageUrl"
             alt="@adCardTitle"
             class="gtx-ad-card-img vehicle-image"
             width="600"
             height="450"
             loading="lazy"
             decoding="async"
             fetchpriority="low" />
        <span class="gtx-ad-card-mileage">@Model.Mileage.ToString("N0") @I18n.R("All_Miles")</span>
    </div>

    <div class="gtx-ad-card-body">
        <h6 class="gtx-ad-card-title">@Model.Year @Model.Make @Model.Model</h6>
        <div class="gtx-ad-card-subtitle">@Model.VehicleStyle</div>

        <div class="gtx-ad-price-panel">
            @if (Model.RetailPrice > 0)
            {
                <div class="gtx-ad-price-row gtx-ad-retail">
                    <span>@I18n.R("All_RetailPrice")</span>
                    <span class="gtx-ad-price-amount">@Model.RetailPrice.ToString("C0", usCulture)</span>
                </div>
            }
            <div class="gtx-ad-price-row">
                <span>@I18n.R("All_InternetPrice")</span>
                <span class="gtx-ad-price-amount">@Model.InternetPrice.ToString("C0", usCulture)</span>
            </div>
            @if (Model.InternetPrice > 0)
            {
                <div class="gtx-ad-price-row">
                    <span>@I18n.R("All_DocumentaryFee")</span>
                    <span class="gtx-ad-price-amount">@documentaryFee.ToString("C0", usCulture)</span>
                </div>
            }
            <div class="gtx-ad-price-row gtx-ad-transparent">
                <span><i class="bi bi-patch-check-fill text-warning me-1"></i>@I18n.R("All_TransparentPrice")</span>
                <span class="gtx-ad-price-amount">@transparentPrice.ToString("C0", usCulture)</span>
            </div>
        </div>

    </div>
</div>
