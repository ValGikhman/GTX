<script type="text/javascript">
    (function (window) {
        function cellText(value) {
            return value == null ? "" : String(value);
        }

        function cellEscapeHtml(value) {
            return cellText(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function cellNormalizeVehicle(vehicle) {
            const row = vehicle || {};
            row.Images = Array.isArray(row.Images) ? row.Images : [];
            return row;
        }

        function renderImageContent(vehicle) {
            const row = cellNormalizeVehicle(vehicle);
            const stock = cellText(row.Stock);
            const imageSource = cellText(row.Image).trim() || cellText(window.inventoryImagesPlaceholderUrl).trim();
            const image = imageSource && typeof window.toInventoryImageUrl === "function"
                ? window.toInventoryImageUrl(imageSource, stock)
                : imageSource;
            const thumbnail = image && typeof window.inventoryImageVariantUrl === "function"
                ? window.inventoryImageVariantUrl(image, "grid")
                : image;
            const imageHtml = image
                ? `<img src="${cellEscapeHtml(thumbnail)}" alt="${cellEscapeHtml(stock)}" class="majordome-thumb majordome-row-image vehicle-image" width="88" height="66" loading="lazy" decoding="async" />`
                : `<div class="majordome-thumb majordome-row-image d-flex align-items-center justify-content-center text-muted small">No image</div>`;

            return imageHtml;
        }

        function renderImageCell(vehicle) {
            return `<td>${renderImageContent(vehicle)}</td>`;
        }

        function renderDetailsContent(vehicle) {
            const row = cellNormalizeVehicle(vehicle);
            const yearMake = `${cellText(row.Year)} ${cellText(row.Make)}`.trim();
            const modelStyle = `${cellText(row.Model)} ${cellText(row.VehicleStyle)}`.trim();
            const vin = cellText(row.VIN);
            const stock = cellText(row.Stock);

            return `
                <div class="majordome-vehicle-title">${cellEscapeHtml(yearMake)}</div>
                <div class="majordome-vehicle-meta">${cellEscapeHtml(modelStyle)}</div>
                <div class="copyable majordome-vehicle-meta majordome-vin-line" data-copy-value="${cellEscapeHtml(vin)}" title="Double-click to copy VIN">VIN: ${cellEscapeHtml(vin)}</div>
                <div class="copyable majordome-vehicle-meta majordome-vin-line" data-copy-value="${cellEscapeHtml(stock)}" title="Double-click to copy Stock#">Stock: ${cellEscapeHtml(stock)}</div>
            `;
        }

        function renderDetailsCell(vehicle) {
            return `<td class="majordome-row-details">${renderDetailsContent(vehicle)}</td>`;
        }

        window.majordomeVehicleCells = {
            renderImageContent: renderImageContent,
            renderImageCell: renderImageCell,
            renderDetailsContent: renderDetailsContent,
            renderDetailsCell: renderDetailsCell
        };
        window.renderMajordomeVehicleImageCell = renderImageCell;
        window.renderMajordomeVehicleDetailsCell = renderDetailsCell;
    })(window);
</script>
