<div class="tab-pane fade" id="tab-details" role="tabpanel">
    <div class="row">
        <!-- Left Column: Form -->
        <div class="col-lg-7">
            <div id="dataOneDetails" class="row mt-3 d-flex justify-content-center">
            </div>
        </div>
        <div class="col-lg-5">
            <section class="majordome-story-panel rounded-4 border shadow-sm p-3 my-3" aria-labelledby="storyLabel">
                <label class="form-label" for="storyTitle">Title</label>
                <div class="input-group mb-3">
                    <input id="storyTitle" class="form-control shadow pull-right" placeholder="Title" />
                    <button id="createStory" type="button" class="btn btn-secondary" data-button-tone="secondary" aria-label="Create story" title="Create story"><i class="bi bi-book" aria-hidden="true"></i></button>
                    <button id="deleteStory" type="button" class="btn btn-secondary" data-button-tone="secondary" aria-label="Delete story" title="Delete story"><i class="bi bi-book-fill" aria-hidden="true"></i></button>
                    <button id="saveStory" type="button" class="btn btn-secondary" data-button-tone="secondary" aria-label="Save story" title="Save story"><i class="bi bi-save" aria-hidden="true"></i></button>
                </div>
                <label id="storyLabel" class="form-label" for="story">Story</label>
                <textarea id="story" class="form-control shadow" aria-labelledby="storyLabel"></textarea>
            </section>
        </div>
    </div>
</div>
