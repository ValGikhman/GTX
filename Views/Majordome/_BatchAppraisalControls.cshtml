<div class="pr-research-workspace">
    <div class="pr-appraisal-toolbar">
        <label class="form-check form-switch d-inline-flex align-items-center gap-2 ps-0 mb-0 small fw-semibold">
            <span>Individual</span>
            <input type="checkbox" class="form-check-input m-0" id="pr-multiple-mode" role="switch"
                   aria-label="Multiple appraisals" aria-controls="pr-individual-inputs pr-batch-inputs pr-individual-results pr-batch-results" />
            <span>Multiple</span>
        </label>
        <div class="pr-appraisal-scope" data-appraisal-scope="multiple" hidden>
            <div>
                <label class="form-label" for="pr-batch-zip"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>ZIP code <span class="text-danger fs-5 fw-bold lh-1" aria-hidden="true">*</span></label>
                <input id="pr-batch-zip" name="zip" form="pr-batch-inputs" class="form-control" value="@GTX.Controllers.MajordomeController.AppraisalDefaultZip"
                       required pattern="[0-9]{5}" maxlength="5" inputmode="numeric" />
            </div>
            <div>
                <label class="form-label" for="pr-batch-radius"><i class="bi bi-bullseye" aria-hidden="true"></i>Radius (mi) <span class="text-danger fs-5 fw-bold lh-1" aria-hidden="true">*</span></label>
                <input id="pr-batch-radius" name="radius" form="pr-batch-inputs" class="form-control" type="number" value="@GTX.Controllers.MajordomeController.AppraisalDefaultRadius"
                       min="1" max="500" step="1" inputmode="numeric" required />
            </div>
        </div>
    </div>
    <div id="pr-individual-inputs">
        @Html.Partial("_AppraisalResearchForm", "pr")
    </div>
    <form id="pr-batch-inputs" hidden
          data-parse-url="@Url.Action("AppraisalParseFile", "Majordome")" data-appraise-url="@Url.Action("AppraiseBatchVehicle", "Majordome")" data-decode-url="@Url.Action("AppraisalDecodeVehicle", "Majordome")"
          data-cargurus-logo="@Url.Content("~/Content/images/cargurus.svg")">
        @Html.AntiForgeryToken()
        <label id="pr-pdf-drop" class="pr-pdf-drop" for="pr-pdf-file">
            <i id="pr-pdf-drop-icon" class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i>
            <span class="pr-pdf-drop-heading">
                <strong id="pr-pdf-drop-title">Drop your auction PDF or CSV here</strong>
                <span id="pr-pdf-drop-badge" class="badge rounded-pill text-bg-success" hidden><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Success</span>
            </span>
            <span id="pr-pdf-drop-summary" aria-live="polite">or click to select a file</span>
            <small id="pr-pdf-drop-hint">PDF or CSV · up to 10 MB · 100 vehicles</small>
            <input id="pr-pdf-file" type="file" accept=".pdf,.csv,application/pdf,text/csv" class="visually-hidden" />
        </label>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" id="pr-batch-run" class="btn btn-gradient ms-auto" disabled><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Appraise all</button>
        </div>
    </form>
</div>
