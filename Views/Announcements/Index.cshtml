@model List<GTX.Models.AnnouncementModel>

@{
    ViewBag.Title = "Announcements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/addTools/addEdit.css?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/addTools/addEdit.css")).Ticks)" rel="stylesheet" />
<script src="~/Scripts/addTools/addEdit.js?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/addTools/addEdit.js")).Ticks)"></script>

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", "Timely messages. Clear visibility." },
    { "Title", "Create the alert." },
    { "Accent", "Control the moment." },
    { "Description", "Manage announcement content, targeting, display behavior, and publishing windows from one workspace." },
    { "Word", "ALERTS" },
    { "Icon", "bi-megaphone" }
})

@Html.Partial("_AnnouncementModal")
<div id="tab-announcement" class="p-3">
    @Html.Partial("_Announcement", Model)
</div>
