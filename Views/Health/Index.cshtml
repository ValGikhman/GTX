@{
    ViewBag.Title = "Health";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cdnEnabled = InventoryImageSettings.CloudflareEnabled;
    var isOwner = string.Equals(
        Convert.ToString(ViewBag.CurrentRole),
        CommonUnit.Roles.Owner.ToString(),
        StringComparison.OrdinalIgnoreCase);
}

<style>
    body {
        background: #eef2f7;
    }

    .wrap {
        max-width: 90%;
        margin-left: auto;
        margin-right: auto;
        padding-bottom: 4.5rem;
    }

    .card-elev {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
    }

    .health-cards-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
    }

    .health-card-col {
        min-width: 0;
    }

    .health-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 22px !important;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        box-shadow: 0 18px 45px rgba(15, 23, 42, .12), 0 2px 8px rgba(15, 23, 42, .06) !important;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .health-card:hover {
        transform: translateY(-2px);
        border-color: rgba(37, 99, 235, .2);
        box-shadow: 0 24px 58px rgba(15, 23, 42, .16), 0 4px 16px rgba(37, 99, 235, .09) !important;
    }

    .health-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 4px;
        background: linear-gradient(90deg, #2563eb, #0f766e);
    }

    .health-card-iis::before {
        background: linear-gradient(90deg, #2563eb, #06b6d4);
    }

    .health-card-cpu::before {
        background: linear-gradient(90deg, #f97316, #ef4444);
    }

    .health-card-memory::before {
        background: linear-gradient(90deg, #7c3aed, #2563eb);
    }

    .health-card-sessions::before {
        background: linear-gradient(90deg, #16a34a, #0f766e);
    }

    .health-card-maintenance::before {
        background: linear-gradient(90deg, #64748b, #334155);
    }

    .health-card-status::before {
        background: linear-gradient(90deg, #0f766e, #2563eb);
    }

    .health-card-cdn::before {
        background: linear-gradient(90deg, #f59e0b, #2563eb);
    }

    .health-card-remove-bg::before {
        background: linear-gradient(90deg, #f59e0b, #7c3aed, #2563eb);
    }

    .health-card-bucket::before {
        background: linear-gradient(90deg, #f97316, #f59e0b, #06b6d4);
    }

    .health-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .85rem;
        margin-bottom: 1rem;
    }

    .health-card-title {
        display: flex;
        align-items: center;
        gap: .8rem;
        min-width: 0;
    }

    .health-icon {
        width: 2.85rem;
        height: 2.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: .9rem;
        color: #fff;
        box-shadow: 0 .85rem 1.7rem rgba(15, 23, 42, .18);
        font-size: 1.25rem;
        flex: 0 0 auto;
    }

    .health-icon-iis {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
    }

    .health-icon-status {
        background: linear-gradient(135deg, #0f766e, #2563eb);
    }

    .health-icon-cpu {
        background: linear-gradient(135deg, #f97316, #ef4444);
    }

    .health-icon-memory {
        background: linear-gradient(135deg, #7c3aed, #2563eb);
    }

    .health-icon-sessions {
        background: linear-gradient(135deg, #16a34a, #0f766e);
    }

    .health-icon-maintenance {
        background: linear-gradient(135deg, #475569, #111827);
    }

    .health-icon-cdn {
        background: linear-gradient(135deg, #f59e0b, #2563eb);
    }

    .health-icon-remove-bg {
        background: linear-gradient(135deg, #f59e0b, #7c3aed 55%, #2563eb);
    }

    .health-icon-bucket {
        background: linear-gradient(135deg, #f97316, #f59e0b 50%, #06b6d4);
    }

    .health-token-value {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .health-token-unit {
        color: #64748b;
        font-size: .8rem;
        font-weight: 750;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

    .health-card-cdn.is-disabled {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    }

    .health-card-cdn.is-disabled::before {
        background: linear-gradient(90deg, #94a3b8, #64748b);
    }

    .health-card-cdn.is-disabled .health-icon-cdn {
        background: linear-gradient(135deg, #64748b, #334155);
    }

    .cdn-service-list {
        display: grid;
        gap: .9rem;
    }

    .cdn-service-name {
        color: #334155;
        font-size: .8rem;
        font-weight: 800;
    }

    .health-refresh-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem;
    }

    .health-refresh-actions .btn {
        width: 100%;
        min-height: 2.15rem;
        min-width: 0;
        border-radius: .7rem;
        white-space: nowrap;
    }

    .health-refresh-actions-single {
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
    }

    .health-refresh-actions-single .btn {
        width: auto;
        min-width: 9.5rem;
        max-width: 100%;
    }

    .health-card-maintenance {
        border: 1px solid rgba(0, 0, 0, .08);
        transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .health-card-maintenance.is-offline {
        background: linear-gradient(180deg, #fff5f5 0%, #ffe3e3 100%);
        border-color: rgba(220, 53, 69, .6);
        box-shadow: 0 22px 54px rgba(220, 53, 69, .22), 0 4px 18px rgba(220, 53, 69, .12) !important;
    }

    .health-card-maintenance.is-offline::before {
        background: linear-gradient(90deg, #dc3545, #f97316);
    }

    .health-card-maintenance.is-offline .health-icon-maintenance {
        background: linear-gradient(135deg, #dc3545, #f97316);
        box-shadow: 0 .85rem 1.7rem rgba(220, 53, 69, .25);
    }

    .health-card-maintenance.is-offline .kpi-label,
    .health-card-maintenance.is-offline .kpi-sub,
    .health-card-maintenance.is-offline .kpi-value {
        color: #842029 !important;
    }

    .health-card-maintenance.is-offline #offlineStatusText {
        color: #b02a37 !important;
        font-weight: 800;
    }

    .kpi-label {
        font-size: .8rem;
        color: rgba(33,37,41,.65);
        letter-spacing: .02em;
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .kpi-sub {
        font-size: .85rem;
        color: rgba(33,37,41,.65);
    }

    .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .pill {
        border-radius: 999px;
    }

    .progress {
        height: 10px;
        border-radius: 999px;
        background: rgba(0,0,0,.06);
    }

    .progress-bar {
        border-radius: 999px;
    }

    .table thead th {
        font-size: .8rem;
        color: rgba(33,37,41,.65);
        font-weight: 700;
        border-bottom: 1px solid rgba(0,0,0,.06);
        white-space: nowrap;
    }

    .table td {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .cell-metric {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
    }

        .cell-metric .val {
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .cell-metric .unit {
            font-size: .8rem;
            color: rgba(33,37,41,.6);
        }

    /* Optional: slightly tighter padding on very small screens */
    @@media (max-width: 575.98px) {
        .health-card {
            padding: 1.25rem !important;
        }
        /* ~p-4 */
        .kpi-value {
            font-size: 1.75rem;
        }
    }

    /* Bigger Bootstrap switch */
    .big-switch.form-check-input {
        width: 3.4rem;
        height: 1.8rem;
        margin-top: 0;
        cursor: pointer;
    }

    .maintenance-switch-row {
        padding-left: 0;
        gap: .75rem;
    }

    .maintenance-switch-row .form-check-label,
    .maintenance-switch-row .form-check-input {
        flex: 0 0 auto;
        margin: 0;
    }

    .maintenance-switch-row .form-check-input {
        float: none;
    }

        /* Improve thumb size/position for the bigger switch */
        .big-switch.form-check-input:checked {
            background-position: right center;
        }

    /* Optional: slightly bigger label next to it */
    .form-check-label {
        cursor: pointer;
    }
</style>

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", "Live operational awareness" },
    { "Title", "Know the system." },
    { "Accent", "Stay ahead." },
    { "Description", "Monitor application health, server resources, active sessions, and maintenance state in real time." },
    { "Word", "HEALTH" },
    { "Icon", "bi-activity" }
})

<div class="container pt-4 wrap">

    <!-- ROW: Cards -->
    <div class="health-cards-row">

        <!-- Live Status Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-status">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-status">
                            <i class="bi bi-activity"></i>
                        </div>
                        <div>
                            <div class="kpi-label">Live status</div>
                        </div>
                    </div>
                    <span id="statusBadge" class="badge text-bg-secondary pill">Idle</span>
                </div>

                <div class="mt-3">
                    <div id="statusText" class="kpi-value">Polling…</div>
                    <div class="kpi-sub mt-2">
                        <i class="bi bi-clock-history me-1"></i>Updated: <span class="mono" id="updated">—</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- IIS Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-iis">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-iis">
                            <i class="bi bi-hdd-network"></i>
                        </div>
                        <div>
                            <div class="kpi-label">IIS</div>
                            <div class="kpi-sub">App pool process</div>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-end justify-content-between">
                        <div class="kpi-value" id="iisCpu">—</div>
                        <div class="kpi-sub">CPU</div>
                    </div>
                    <div class="progress mt-2">
                        <div id="iisCpuBar" class="progress-bar" style="width:0%"></div>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="d-flex align-items-end justify-content-between">
                        <div class="kpi-value" id="iisMem">—</div>
                        <div class="kpi-sub">Memory</div>
                    </div>
                    <div class="progress mt-2">
                        <div id="iisMemBar" class="progress-bar" style="width:0%"></div>
                    </div>
                </div>

                <div class="kpi-sub mt-4">
                    PID: <span class="mono" id="iisPid">—</span><br />
                    Working Set: <span class="mono" id="iisWs">—</span>
                </div>
            </div>
        </div>

        <!-- Total CPU Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-cpu">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-cpu">
                            <i class="bi bi-cpu"></i>
                        </div>
                        <div>
                            <div class="kpi-label">Total CPU</div>
                            <div class="kpi-sub">System load</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-1 flex-wrap gap-2">
                    <div class="kpi-value" id="totCpu">—</div>
                </div>
                <div class="progress mt-2">
                    <div id="totCpuBar" class="progress-bar" style="width:0%"></div>
                </div>
                <div class="kpi-sub mt-2">System-wide usage</div>
            </div>
        </div>

        <!-- Total Memory Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-memory">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-memory">
                            <i class="bi bi-memory"></i>
                        </div>
                        <div>
                            <div class="kpi-label">Total Memory Used</div>
                            <div class="kpi-sub">Server memory</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-1 flex-wrap gap-2">
                    <div class="kpi-value" id="totMem">—</div>
                    <div class="kpi-sub mono" id="updated2">—</div>
                </div>
                <div class="progress mt-2">
                    <div id="totMemBar" class="progress-bar" style="width:0%"></div>
                </div>
                <div class="kpi-sub mt-2" id="totRam">—</div>
                <div class="kpi-sub mt-1" id="totMemLoad" style="display:none;"></div>
            </div>
        </div>

        <!-- Active Sessions Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-sessions">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-sessions">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="kpi-label">Active Sessions</div>
                            <div class="kpi-sub">IIS app pool</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-end justify-content-between mt-1">
                    <div class="kpi-value" id="activeSessions">—</div>
                </div>

                <div class="kpi-sub mt-2">
                    Session-based (IIS app pool)
                </div>
            </div>
        </div>

        <!-- Offline / Maintenance Mode Card -->
        <div class="health-card-col">
            <div id="maintenanceCard" class="h-100 well p-4 health-card health-card-maintenance d-flex flex-column">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-maintenance">
                            <i class="bi bi-shield-exclamation"></i>
                        </div>
                        <div>
                            <div class="kpi-label mb-0">Maintenance</div>
                            <div class="kpi-sub mt-1" id="offlineStatusText">Online</div>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="flex-grow-1">
                    <div id="maintenanceStateValue" class="kpi-value">Online</div>
                    <div class="kpi-sub mt-2">
                        When enabled, visitors are redirected to the out-of-service page.
                    </div>
                </div>

                <!-- Maintenance switch (bottom action) -->
                <div class="form-check form-switch maintenance-switch-row m-0 d-flex flex-nowrap align-items-center pt-4 mt-auto">
                    <label id="maintenanceSwitchLabel" class="form-check-label kpi-sub user-select-none text-nowrap mb-0" for="chkOffline">
                        Maintenance mode
                    </label>
                    <input class="form-check-input big-switch m-0" type="checkbox" id="chkOffline" role="switch">
                </div>
            </div>
        </div>

        <!-- Cloudflare CDN Card -->
        <div class="health-card-col">
            <div class="h-100 well p-4 health-card health-card-cdn d-flex flex-column @(cdnEnabled ? string.Empty : "is-disabled")">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-cdn">
                            <i class="bi bi-cloud-arrow-down"></i>
                        </div>
                        <div>
                            <div class="kpi-label mb-0">Cloudflare CDN Purge</div>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1">
                    <div class="kpi-value">@(cdnEnabled ? "Cloudflare" : "Local")</div>
                    <div class="cdn-service-list mt-3">
                        <div>
                            <div class="cdn-service-name"><i class="bi bi-car-front-fill me-1" aria-hidden="true"></i>Inventory purge</div>
                        <div id="inventoryCdnStatus" class="kpi-sub mt-2">
                            @(cdnEnabled
                                ? "Inventory images"
                                : "Inventory images are served on-site; CDN refresh is unavailable.")
                        </div>
                        </div>
                        <div>
                            <div class="cdn-service-name"><i class="bi bi-images me-1" aria-hidden="true"></i>Images purge</div>
                        <div id="siteImagesCdnStatus" class="kpi-sub mt-2">
                            @(cdnEnabled
                                ? "GTX/SiteImages assets"
                                : "Site images are served on-site; CDN refresh is unavailable.")
