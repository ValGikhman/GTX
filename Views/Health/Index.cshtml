        </div>

        <!-- GTX Cloudflare Bucket Card -->
        <div class="health-card-col">
            <div id="cloudflareBucketHealthCard" class="h-100 well p-4 health-card health-card-bucket d-flex flex-column">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-bucket">
                            <i class="bi bi-cloud-fill"></i>
                        </div>
                        <div>
                            <div class="kpi-label mb-0">GTX R2 Bucket</div>
                            <div class="kpi-sub mt-1">Cloudflare Inventory</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex flex-column flex-grow-1">
                    <div class="health-token-value">
                        <div id="cloudflareImageCount" class="kpi-value">—</div>
                        <div class="health-token-unit">images hosted</div>
                    </div>
                    <div id="cloudflareBucketDetail" class="kpi-sub mt-2">Reading the GTX bucket…</div>
                    <div class="health-refresh-actions health-refresh-actions-single pt-4 mt-auto">
