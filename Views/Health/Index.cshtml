        <!-- Background Removal Token Card -->
        <div class="health-card-col">
            <div id="removeBgHealthCard" class="h-100 well p-4 health-card health-card-remove-bg d-flex flex-column">
                <div class="health-card-head">
                    <div class="health-card-title">
                        <div class="health-icon health-icon-remove-bg">
                            <i class="bi bi-eraser-fill"></i>
                        </div>
                        <div>
                            <div class="kpi-label mb-0">remove.bg</div>
                            <div class="kpi-sub mt-1">Token balance</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex flex-column flex-grow-1">
                    <div class="health-token-value">
                        <div id="removeBgTokenCount" class="kpi-value">—</div>
                        <div class="health-token-unit">tokens available</div>
                    </div>
                    <div id="removeBgTokenDetail" class="kpi-sub mt-2">Contacting remove.bg…</div>
                    <div class="health-refresh-actions health-refresh-actions-single pt-4 mt-auto">
                        <button type="button" id="btnRefreshRemoveBgTokens" class="btn btn-sm btn-outline-success shadow-sm">
                            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Refresh balance
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const healthUrl = '@Url.Action("HealthJson", "Health")';
    const getOfflineUrl = '@Url.Action("GetOffline", "Health")';
    const setOfflineUrl = '@Url.Action("SetOffline", "Health")';
    const refreshInventoryCdnUrl = '@Url.Action("RefreshInventoryCdn", "Health")';
    const refreshSiteImagesCdnUrl = '@Url.Action("RefreshSiteImagesCdn", "Health")';
    const inventoryBucketStatsUrl = '@Url.Action("InventoryBucketStats", "Health")';
    const removeBgAccountUrl = '@Url.Action("GetRemoveBgAccount", "Majordome")';
    const POLL_VISIBLE_MS = 2000;

    let pollTimer = null;
    let requestInFlight = false;
    let disposed = false;

    function fmtBytes(b) {
        if (b === null || b === undefined) return "—";
        const u = ["B", "KB", "MB", "GB", "TB"];
        let i = 0, n = Number(b);
        while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
        return (i === 0 ? n.toFixed(0) : n.toFixed(2)) + " " + u[i];
    }

    function fmtPct(v) {
        if (v === null || v === undefined || isNaN(v)) return "—";
        return Number(v).toFixed(1);
    }

    function fmtPctWithSymbol(v) {
        const pct = fmtPct(v);
        return pct === "—" ? pct : pct + "%";
    }

    function clampPct(v) {
        v = Number(v);
        if (isNaN(v)) return 0;
        if (v < 0) return 0;
        if (v > 100) return 100;
        return v;
    }

    function setBar($bar, pct) {
        $bar.css("width", clampPct(pct).toFixed(1) + "%");
    }

    function setStatus(state, text) {
        const $badge = dom.statusBadge;
        const $statusText = dom.statusText;

        $badge.removeClass("text-bg-secondary text-bg-success text-bg-warning text-bg-danger");

        if (state === "ok") { $badge.addClass("text-bg-success").text("OK"); }
        else if (state === "loading") { $badge.addClass("text-bg-warning").text("Loading"); }
        else if (state === "error") { $badge.addClass("text-bg-danger").text("Error"); }
        else { $badge.addClass("text-bg-secondary").text("Idle"); }

        $statusText.text(text || "");
    }

    function safeGet(obj, path, fallback) {
        try { return path.split(".").reduce((o, k) => o && o[k], obj) ?? fallback; }
        catch { return fallback; }
    }

    function parseNetDate(v) {
        if (!v) return null;
        const iso = new Date(v);
        if (!isNaN(iso)) return iso;
        const m = /\/Date\((\d+)(?:[+-]\d+)?\)\//.exec(v);
        if (m) return new Date(parseInt(m[1], 10));
        return null;
    }

    function scheduleNextPoll(immediate) {
        if (disposed) return;
        if (pollTimer) {
            clearTimeout(pollTimer);
        }

        const delay = immediate ? 0 : POLL_VISIBLE_MS;
        pollTimer = setTimeout(refreshNow, delay);
    }

    const dom = {};

    const cdnRefreshTargets = {
        inventory: {
            buttonSelector: "#btnRefreshInventoryCdn",
            statusSelector: "#inventoryCdnStatus",
            url: refreshInventoryCdnUrl,
            title: "Refresh entire inventory CDN cache",
            message: "Refresh the complete inventory image hostname? The next image requests will be fetched fresh from R2 and may be briefly slower while the CDN warms again.",
            progressText: "Refreshing the inventory CDN cache..."
        },
        site: {
            buttonSelector: "#btnRefreshSiteImagesCdn",
            statusSelector: "#siteImagesCdnStatus",
            url: refreshSiteImagesCdnUrl,
            title: "Refresh SiteImages CDN cache",
            message: "Refresh the GTX/SiteImages CDN prefix, including site images and videos? The next requests may be briefly slower while the CDN warms again.",
            progressText: "Refreshing the SiteImages and video CDN cache..."
        }
    };

    function bindCdnRefresh() {
        $.each(cdnRefreshTargets, function (_, target) {
            $(target.buttonSelector).on("click", async function () {
                const $button = $(this);
                const $status = $(target.statusSelector);
                if ($button.is(":disabled")) return;

                const confirmed = await window.gtxConfirm({
                    title: target.title,
                    message: target.message,
                    confirmText: "Purge cache",
                    variant: "warning",
                    iconClass: "bi bi-cloud-arrow-down"
                });
                if (!confirmed) return;

                const originalHtml = $button.html();
                $button.prop("disabled", true)
                    .html('<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Purging...');
                $status.text(target.progressText);

                $.ajax({
                    url: target.url,
                    method: "POST",
                    dataType: "json",
                    timeout: 30000
                })
                    .done(function (response) {
                        if (!response || !response.success) {
                            const message = (response && response.message) || "Cloudflare cache purge failed.";
                            $status.text(message);
                            window.gtxAlert(message);
                            return;
                        }

                        $status.text("Purged");
                        $button
                            .html('<i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Purged');
                    })
                    .fail(function (xhr) {
                        const message = xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : "Cloudflare cache purge failed.";
                        $status.text(message);
                        window.gtxAlert(message);
                    })
                    .always(function () {
                        window.setTimeout(function () {
                            $button
                                .prop("disabled", false)
                                .html(originalHtml);
                        }, 2500);
                    });
            });
        });
    }

    function refreshRemoveBgTokenBalance() {
        const $button = $("#btnRefreshRemoveBgTokens");
        const $count = $("#removeBgTokenCount");
        const $detail = $("#removeBgTokenDetail");
        const originalHtml = $button.html();

        $button.prop("disabled", true)
            .html('<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Checking…');
        $detail.text("Contacting remove.bg…");

        $.ajax({
            url: removeBgAccountUrl,
            method: "GET",
            cache: false,
            dataType: "json",
            timeout: 25000
        })
            .done(function (response) {
                if (!response || !response.success) {
                    $count.text("—");
                    $detail.text((response && response.message) || "The remove.bg balance could not be loaded.");
                    return;
                }

                const total = Math.max(0, Math.floor(Number(response.totalTokens) || 0));
                const credits = Math.max(0, Number(response.credits) || 0);
                const freeCalls = Math.max(0, Number(response.freeCalls) || 0);
                $count.text(total.toLocaleString("en-US"));
                $detail.text(`${credits.toLocaleString("en-US")} credits + ${freeCalls.toLocaleString("en-US")} free calls`);
            })
            .fail(function (xhr) {
                const message = xhr.responseJSON && xhr.responseJSON.message
                    ? xhr.responseJSON.message
                    : "The remove.bg balance could not be loaded.";
                $count.text("—");
                $detail.text(message);
            })
            .always(function () {
                $button.prop("disabled", false).html(originalHtml);
            });
    }

    function refreshCloudflareBucketStats() {
        const $button = $("#btnRefreshCloudflareBucket");
        const $count = $("#cloudflareImageCount");
        const $detail = $("#cloudflareBucketDetail");
        const originalHtml = $button.html();

        $button.prop("disabled", true)
            .html('<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Counting…');
        $detail.text("Reading the GTX bucket…");

        $.ajax({
            url: inventoryBucketStatsUrl,
            method: "GET",
            cache: false,
            dataType: "json",
            timeout: 30000
        })
            .done(function (response) {
                if (!response || !response.success) {
                    $count.text("—");
                    $detail.text((response && response.message) || "The GTX bucket could not be counted.");
                    return;
                }

                const imageCount = Math.max(0, Number(response.ImageObjects) || 0);
                const stockFolders = Math.max(0, Number(response.StockFolders) || 0);
                const imageBytes = Math.max(0, Number(response.ImageBytes) || 0);
                const otherObjects = Math.max(0, Number(response.OtherObjects) || 0);
                $count.text(imageCount.toLocaleString("en-US"));
                $detail.text(`${stockFolders.toLocaleString("en-US")} stock folders · ${fmtBytes(imageBytes)} images · ${otherObjects.toLocaleString("en-US")} other objects`);
            })
            .fail(function (xhr) {
                const message = xhr.responseJSON && xhr.responseJSON.message
                    ? xhr.responseJSON.message
                    : "The GTX bucket could not be counted.";
                $count.text("—");
                $detail.text(message);
            })
            .always(function () {
                $button.prop("disabled", false).html(originalHtml);
            });
    }

    function refreshNow() {
        if (disposed || document.visibilityState === "hidden") {
            return;
        }

        if (requestInFlight) {
            scheduleNextPoll(false);
            return;
        }

        requestInFlight = true;
        setStatus("loading", "Refreshing…");

        $.ajax({
            url: healthUrl,
            method: "GET",
            cache: false,
            dataType: "json",
            timeout: 8000,
            success: function (data) {
                const totCpu = safeGet(data, "Totals.CpuPercentTotal", 0);
                const totMem = safeGet(data, "Totals.MemoryPercentTotal", 0);
                const totalPhys = safeGet(data, "Totals.TotalPhysBytes", null);
                const availPhys = safeGet(data, "Totals.AvailPhysBytes", null);

                dom.totCpu.text(fmtPctWithSymbol(totCpu));
                dom.totMem.text(fmtPctWithSymbol(totMem));
                setBar(dom.totCpuBar, totCpu);
                setBar(dom.totMemBar, totMem);

                dom.totRam.text(`${fmtBytes(totalPhys)} total / ${fmtBytes(availPhys)} free`);

                const memLoad = safeGet(data, "Totals.MemoryLoadPercent", null);
                if (memLoad !== null && memLoad !== undefined) {
                    dom.totMemLoad.show().text(`Windows MemoryLoad: ${memLoad}%`);
                } else {
                    dom.totMemLoad.hide();
                }

                const stRaw = safeGet(data, "ServerTime", null);
                const st = parseNetDate(stRaw);
                const timeText = st ? st.toLocaleTimeString() : "—";
                dom.updated.text(timeText);
                dom.updated2.text(timeText);

                const iis = safeGet(data, "IIS", null);
                dom.iisPid.text(safeGet(iis, "Pid", "—"));
                dom.iisCpu.text(fmtPctWithSymbol(safeGet(iis, "CpuPercent", null)));
                dom.iisMem.text(fmtPctWithSymbol(safeGet(iis, "MemoryPercent", null)));
                dom.iisWs.text(fmtBytes(safeGet(iis, "WorkingSetBytes", null)));
                setBar(dom.iisCpuBar, safeGet(iis, "CpuPercent", 0));
                setBar(dom.iisMemBar, safeGet(iis, "MemoryPercent", 0));

                const act = safeGet(data, "ActiveSessions", null);
                dom.activeSessions.text(act === null ? "—" : act);

                setStatus("ok", "Live");
            },
            error: function (xhr) {
                setStatus("error", "HTTP " + (xhr && xhr.status ? xhr.status : "error"));
            },
            complete: function () {
                requestInFlight = false;
                scheduleNextPoll(false);
            }
        });
    }

    $(function () {
        dom.statusBadge = $("#statusBadge");
        dom.statusText = $("#statusText");
        dom.updated = $("#updated");
        dom.updated2 = $("#updated2");
        dom.totCpu = $("#totCpu");
        dom.totMem = $("#totMem");
        dom.totCpuBar = $("#totCpuBar");
        dom.totMemBar = $("#totMemBar");
        dom.totRam = $("#totRam");
        dom.totMemLoad = $("#totMemLoad");
        dom.iisPid = $("#iisPid");
        dom.iisCpu = $("#iisCpu");
        dom.iisMem = $("#iisMem");
        dom.iisWs = $("#iisWs");
        dom.iisCpuBar = $("#iisCpuBar");
        dom.iisMemBar = $("#iisMemBar");
        dom.activeSessions = $("#activeSessions");
        dom.chkOffline = $("#chkOffline");
        dom.offlineStatusText = $("#offlineStatusText");
        dom.maintenanceStateValue = $("#maintenanceStateValue");
        dom.maintenanceSwitchLabel = $("#maintenanceSwitchLabel");
        dom.maintenanceCard = $("#maintenanceCard");
        let offlineState = false;
        let offlineConfirmationPending = false;

        function setUi(isOffline) {
            offlineState = !!isOffline;
            dom.chkOffline.prop("checked", isOffline);
            dom.offlineStatusText.text(isOffline ? "Offline (redirecting users)" : "Online");
            dom.maintenanceStateValue.text(isOffline ? "Offline" : "Online");
            dom.maintenanceSwitchLabel.text("Maintenance mode");
            dom.maintenanceCard.toggleClass("is-offline", isOffline);
        }

        // Load current state
        $.get(getOfflineUrl, function (r) {
            setUi(!!r.isOffline);
        });

        // Toggle
        dom.chkOffline.on("change", async function () {
            if (offlineConfirmationPending) return;

            const on = this.checked;
            const previous = offlineState;
            offlineConfirmationPending = true;
            dom.chkOffline.prop("disabled", true);

            const confirmed = await window.gtxConfirm({
                title: on ? "Enable maintenance mode" : "Disable maintenance mode",
                message: on
                    ? "Enable offline mode? Visitors will be redirected to the out-of-service page."
                    : "Disable offline mode? Visitors will be able to browse the site again.",
                confirmText: on ? "Enable" : "Disable",
                variant: on ? "warning" : "primary",
                iconClass: "bi bi-shield-exclamation"
            });

            if (!confirmed) {
                setUi(previous);
                offlineConfirmationPending = false;
                dom.chkOffline.prop("disabled", false);
                return;
            }

            setUi(on);

            $.post(setOfflineUrl, { isOffline: on })
                .done(function (r) {
                    setUi(!!(r && r.isOffline));
                })
                .fail(function (xhr) {
                    // If server rejects, revert UI
                    setUi(previous);
                    window.gtxAlert("Failed to update maintenance mode.\n" + xhr.status + " " + xhr.statusText);
                })
                .always(function () {
                    offlineConfirmationPending = false;
                    dom.chkOffline.prop("disabled", false);
                });
        });

        bindCdnRefresh();

        $("#btnRefreshRemoveBgTokens").on("click", refreshRemoveBgTokenBalance);
        refreshRemoveBgTokenBalance();
        $("#btnRefreshCloudflareBucket").on("click", refreshCloudflareBucketStats);
        refreshCloudflareBucketStats();

        $(document).on("visibilitychange.health", function () {
            if (document.visibilityState === "visible") {
                scheduleNextPoll(true);
            } else if (pollTimer) {
                clearTimeout(pollTimer);
                pollTimer = null;
            }
        });

        $(window).on("pagehide.health beforeunload.health", function () {
            disposed = true;
            if (pollTimer) {
                clearTimeout(pollTimer);
                pollTimer = null;
            }
        });

        scheduleNextPoll(true);
    });
</script>
