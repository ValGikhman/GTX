                                @(cdnEnabled ? null : "disabled")>
                            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Inventory
                        </button>
                        <button type="button" id="btnRefreshSiteImagesCdn"
                                class="btn btn-sm btn-outline-success shadow-sm"
                                @(cdnEnabled ? null : "disabled")>
                            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Images
