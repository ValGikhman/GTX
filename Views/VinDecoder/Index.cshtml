@{
    ViewBag.Title = "VIN Decoder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", "Seventeen characters. One complete picture." },
    { "Title", "Decode with" },
    { "Accent", "confidence." },
    { "Description", "Turn a VIN into clear vehicle specifications with a fast, focused decoding workspace." },
    { "Word", "DECODE" },
    { "Icon", "bi-upc-scan" }
})

<div id="vindecoderOverlay" class="spinner-overlay spinner-hidden" aria-hidden="true">
    <div class="text-center">
        <div class="spinner-border text-light" role="status" aria-label="Working..."></div>
        <div class="text-light mt-3 small opacity-75">Decoding VIN…</div>
    </div>
</div>


<main class="marketing-page vin-decoder-page">
    <section class="marketing-content-shell vin-decoder-shell">
        <div class="marketing-section-label">
            <span>Vehicle identity workspace</span>
            <small>DataOne VIN intelligence</small>
        </div>

        <section class="vin-decoder-console" aria-labelledby="vinDecoderConsoleTitle">
            <div class="vin-decoder-console-copy">
                <span class="vin-decoder-console-icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
                <span>
                    <small>Ready to decode</small>
                    <h2 id="vinDecoderConsoleTitle">Enter a 17-character VIN</h2>
                </span>
            </div>

            <div class="vin-decoder-controls">
                <div class="input-group input-group-lg vin-decoder-input-group flex-nowrap">
                    <span class="input-group-text">
                        <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                    </span>

                    <input id="vin" class="form-control" placeholder="e.g., 1HGCM82633A004352" aria-label="VIN" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="latin" maxlength="17" />

                    <button id="decode" type="button" class="btn vin-schema-button vin-schema-button-primary vin-decode-icon-button" aria-label="Decode VIN" title="Decode VIN">
                        <i class="bi bi-upc-scan" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="vin-decoder-assist">
                    <button id="clear" type="button" class="btn vin-schema-button vin-schema-button-secondary">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>Clear
                    </button>
                </div>

                <div id="vinError" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span class="msg">Invalid VIN.</span>
                </div>
            </div>
        </section>

        <section class="vin-decoder-results" aria-label="Decoded VIN results">
            <div id="dataOneVinDecoder"></div>

            <div id="emptyState" class="vin-decoder-empty">
                <span aria-hidden="true"><i class="bi bi-search"></i></span>
                <strong>Waiting for a VIN</strong>
                <small>Decoded specifications will appear here.</small>
            </div>
        </section>
    </section>
</main>

<script>
    $(function () {
        const $vin = $("#vin");
        const $btn = $("#decode");
        const $clear = $("#clear");
        const $overlay = $("#vindecoderOverlay");
        const $err = $("#vinError");
        const $errMsg = $("#vinError .msg");
        const $result = $("#dataOneVinDecoder");
        const $empty = $("#emptyState");

        function showError(message) {
            $errMsg.text(message);
            $err.removeClass("d-none");
            // Shake the input group subtly
            const $group = $vin.closest(".input-group");
            $group.addClass("shake");
            setTimeout(() => $group.removeClass("shake"), 300);
        }

        function clearError() {
            $err.addClass("d-none");
        }

        function normalizeVin(value) {
            return (value || "").trim().toUpperCase();
        }

        function validateVin(vin) {
            // Basic VIN validation: 17 chars, no I O Q
            if (!vin) return "Please enter a VIN.";
            if (vin.length !== 17) return "VIN must be exactly 17 characters.";
            if (/[IOQ]/.test(vin)) return "VIN cannot contain I, O, or Q.";
            return null;
        }

        async function decodeDataOneByAnyVin(vin) {
            showSpinner($overlay);
            clearError();

            try {
                const res = await fetch(`${root}Vindecoder/DecodeDataOneByAnyVin?vin=${encodeURIComponent(vin)}`, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!res.ok) throw new Error(`Server returned ${res.status}`);

                const html = await res.text();
                $empty.hide();
                if (window.gtxSecurity && typeof window.gtxSecurity.setSafeHtml === "function") {
                    window.gtxSecurity.setSafeHtml($result, html);
                } else {
                    $result.text(html);
                }

                $result.addClass("fade-in");
                setTimeout(() => $result.removeClass("fade-in"), 250);
            }
            catch (err) {
                console.error("DecodeDataOneByAnyVin failed:", err);
                showError("Failed to decode VIN. Please try again.");
            }
            finally {
                hideSpinner($overlay);
            }
        }

        function submit() {
            const vin = normalizeVin($vin.val());
            $vin.val(vin);

            const error = validateVin(vin);
            if (error) {
                showError(error);
                $vin.trigger("focus").select();
                return;
            }

            decodeDataOneByAnyVin(vin);
        }

        $btn.on("click", submit);

        $vin.on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                submit();
            }
        }).on("input", function () {
            // hide error as user types
            clearError();
        }).trigger("focus");

        $clear.on("click", function () {
            $vin.val("").trigger("focus");
            $result.empty();
            $empty.show();
            clearError();
        });
    });
</script>
