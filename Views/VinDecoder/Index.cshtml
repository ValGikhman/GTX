@{
    ViewBag.Title = "VIN Decoder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_MarketingHero", null, new ViewDataDictionary
{
    { "Kicker", I18n.R("Hero_VinDecoder_Kicker") },
    { "Title", I18n.R("Hero_VinDecoder_Title") },
    { "Accent", I18n.R("Hero_VinDecoder_Accent") },
    { "Description", I18n.R("Hero_VinDecoder_Description") },
    { "Word", I18n.R("Hero_VinDecoder_Word") },
    { "Icon", "bi-upc-scan" }
})

<div id="vindecoderOverlay" class="spinner-overlay spinner-hidden" aria-hidden="true">
    <div class="text-center">
        <div class="spinner-border text-light" role="status" aria-label="Working..."></div>
        <div id="vinWorkingMessage" class="text-light mt-3 small opacity-75">Decoding VIN…</div>
    </div>
</div>


<main class="marketing-page vin-decoder-page">
    <section class="marketing-content-shell vin-decoder-shell">
        <div class="marketing-section-label">
            <span>@I18n.R("Section_VehicleIdentity")</span>
            <small>@I18n.R("Section_VinIntelligence")</small>
        </div>

        <section class="vin-decoder-console vin-decoder-console-centered" aria-labelledby="vinDecoderConsoleTitle">
            <div class="vin-decoder-console-copy">
                <span class="vin-decoder-console-icon" aria-hidden="true"><i class="bi bi-upc-scan"></i></span>
                <span>
                    <small>Ready to decode</small>
                    <h2 id="vinDecoderConsoleTitle">Enter a 17-character VIN</h2>
                </span>
            </div>

            <div class="vin-decoder-controls">
                @Html.AntiForgeryToken()
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <label for="vinProvider" class="form-label small fw-semibold text-shadow-small mb-0">Decoder</label>
                    <select id="vinProvider" class="form-select form-select-sm w-auto flex-grow-1" autocomplete="off">
                        <option value="dataone" selected="selected">DataOne</option>
                        <option value="neovin">MarketCheck NeoVIN</option>
                    </select>
                </div>
                <div class="vin-decoder-entry-row">
                    <div class="input-group input-group-lg vin-decoder-input-group flex-nowrap">
                        <span class="input-group-text">
                            <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                        </span>

                        <input id="vin" class="form-control" placeholder="e.g., 1HGCM82633A004352" aria-label="VIN" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="latin" maxlength="17" />

                        <button id="decode" type="button" disabled class="btn vin-schema-button vin-schema-button-primary vin-decode-icon-button" aria-label="Decode VIN" title="Decode VIN">
                            <i class="bi bi-upc-scan" aria-hidden="true"></i>
                        </button>
                    </div>
                    <button id="clear" type="button" class="btn vin-schema-button vin-schema-button-secondary" aria-label="Clear VIN" title="Clear VIN">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <button id="loadSaved" type="button" disabled class="btn btn-sm vin-schema-button vin-schema-button-secondary">
                        <i class="bi bi-archive me-1" aria-hidden="true"></i>Load saved
                    </button>
                    <span id="vinReportStatus" class="small" role="status" aria-live="polite"></span>
                </div>

                <div id="vinError" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span class="msg">Invalid VIN.</span>
                </div>
            </div>
        </section>

        <section class="vin-decoder-results" aria-label="Decoded VIN results">
            <div id="dataOneVinDecoder"></div>

            <div id="emptyState" class="vin-decoder-empty">
                <span aria-hidden="true"><i class="bi bi-search"></i></span>
                <strong>Waiting for a VIN</strong>
                <small>Decoded specifications will appear here.</small>
            </div>
        </section>
    </section>
</main>

<script>
    $(function () {
        const $vin = $("#vin");
        const $btn = $("#decode");
        const $clear = $("#clear");
        const $load = $("#loadSaved");
        const $provider = $("#vinProvider");
        const $overlay = $("#vindecoderOverlay");
        const $workingMessage = $("#vinWorkingMessage");
        const $err = $("#vinError");
        const $errMsg = $("#vinError .msg");
        const $result = $("#dataOneVinDecoder");
        const $empty = $("#emptyState");
        const $reportStatus = $("#vinReportStatus");
        const $controls = $btn.add($clear).add($vin).add($provider).add($load);
        const $token = $(".vin-decoder-controls input[name='__RequestVerificationToken']");
        const providerUrls = {
            dataone: '@Url.Action("DecodeDataOneByAnyVin", "VinDecoder")',
            neovin: '@Url.Action("DecodeMarketCheckByAnyVin", "VinDecoder")'
        };
        let decoding = false;
        let selectedProvider = $provider.val();
        let requestedVin = "";

        function showError(message) {
            $errMsg.text(message);
            $err.removeClass("d-none");
            const $group = $vin.closest(".input-group");
            $group.addClass("shake");
            setTimeout(() => $group.removeClass("shake"), 300);
        }

        function clearError() {
            $err.addClass("d-none");
            $errMsg.text("");
        }

        function clearReport() {
            clearError();
            $result.empty();
            $empty.show();
            $reportStatus.text("");
        }

        function validateVin(vin) {
            if (!vin) return "Please enter a VIN.";
            if (vin.length !== 17) return "VIN must be exactly 17 characters.";
            if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(vin)) return "VIN must contain only letters and numbers, excluding I, O, and Q.";
            return null;
        }

        function readVin() {
            return ($vin.val() || "").trim().toUpperCase();
        }

        function updateActionButtons() {
            const disabled = decoding || validateVin(readVin()) !== null || !Object.prototype.hasOwnProperty.call(providerUrls, $provider.val());
            $btn.prop("disabled", disabled);
            $load.prop("disabled", disabled);
        }

        async function requestReport(loadSaved) {
            if (decoding) return;

            const vin = readVin();
            $vin.val(vin);
            const error = validateVin(vin);
            if (error) {
                showError(error);
                $vin.trigger("focus").select();
                return;
            }
            const provider = $provider.val();
            if (!Object.prototype.hasOwnProperty.call(providerUrls, provider)) {
                showError("Please select a VIN decoder.");
                return;
            }

            selectedProvider = provider;
            requestedVin = vin;
            decoding = true;
            $controls.prop("disabled", true);
            $workingMessage.text(loadSaved ? "Loading saved report…" : "Decoding VIN…");
            showSpinner($overlay);
            clearError();
            $result.empty();
            $empty.hide();
            $reportStatus.text("");

            try {
                const requestData = { vin: vin, __RequestVerificationToken: $token.val() };
                if (loadSaved) requestData.provider = provider;
                const res = await fetch(loadSaved ? '@Url.Action("LoadSavedReport", "VinDecoder")' : providerUrls[provider], {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                    },
                    body: $.param(requestData)
                });

                if (!res.ok || res.redirected) {
                    const message = loadSaved && res.status === 404
                        ? "No saved report is available for this VIN and decoder."
                        : res.status === 429
                            ? "The VIN decoding limit has been reached. Please try again later."
                            : res.status === 504
                                ? "VIN decoding timed out. Please try again."
                                : res.status === 503
                                    ? "The selected VIN decoding service is not configured or is temporarily unavailable. Ask an administrator to check Services."
                                    : res.redirected || res.status === 401 || res.status === 403
                                        ? "Please sign in again to use the VIN decoder."
                                        : loadSaved ? "Failed to load the saved report. Please try again." : "Failed to decode VIN. Please try again.";
                    throw new Error(message);
                }

                const html = await res.text();
                window.gtxSecurity.setSafeHtml($result, html);
                $result.find("details.avd-style").prop("open", true);
                const saved = (res.headers.get("X-GTX-Vin-Saved") || "").trim().toLowerCase();
                $reportStatus.text(loadSaved ? "Saved report loaded."
                    : saved === "true" ? "Saved for this inventory vehicle."
                    : saved === "false" ? "Decoded. Saving is available for inventory vehicles."
                    : saved === "failed" ? "Decoded, but saving failed. Please try again later."
                    : "Decoded.");

                $result.addClass("fade-in");
                setTimeout(() => $result.removeClass("fade-in"), 250);
            }
            catch (err) {
                $empty.show();
                showError(err.message || "Failed to decode VIN. Please try again.");
            }
            finally {
                hideSpinner($overlay);
                decoding = false;
                $controls.prop("disabled", false);
                updateActionButtons();
            }
        }

        function submit() { return requestReport(false); }
        function loadSavedReport() { return requestReport(true); }
        $btn.on("click", submit);
        $load.on("click", loadSavedReport);

        $vin.on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                submit();
            }
        }).on("input", function () {
            if (decoding) { $vin.val(requestedVin); return; }
            clearReport();
            updateActionButtons();
        }).trigger("focus");
        updateActionButtons();

        $provider.on("change", function () {
            if (decoding) { $provider.val(selectedProvider); return; }
            selectedProvider = $provider.val();
            clearReport();
            updateActionButtons();
        });

        $clear.on("click", function () {
            if (decoding) return;
            $vin.val("").trigger("input").trigger("focus");
        });
    });
</script>
