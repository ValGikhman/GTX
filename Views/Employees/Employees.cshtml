@model GTX.Models.BaseModel
<style>
    .just-validate-error-label {
        margin-left: 65% !important;
    }

    .card:hover {
        transform: none;
    }
</style>
<!-- Modal -->
<div id="message" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div id="header" class="modal-header shadow">
                <span class="gtx-modal-title-icon" aria-hidden="true"><i class="bi bi-chat-dots-fill"></i></span>
                <div id="title" class="modal-title">Contact</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="messageBody" class="modal-body well">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-close-white shadow" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Close</button>
            </div>
        </div>
    </div>
</div>

<section class="container-fluid py-4">
    <ul class="row g-4 justify-content-center list-unstyled">
        @foreach (var employer in Model.Employers) {
            <li class="col-auto">
                <article class="card shadow text-center">
                    <img class="card-img-top rounded-2" src="@Url.Content("~" + (!string.IsNullOrWhiteSpace(employer.PhotoPath) ? employer.PhotoPath : "/SiteImages/staff/empty.jpg"))" alt="@employer.FirstName @employer.LastName">
                    <div class="card-body gradient">
                        <h5 class="card-title">@employer.FirstName @employer.LastName</h5>
                        <div class="card-subtitle text-muted">@employer.Position</div>
                    </div>
                </article>
            </li>
        }
    </ul>
</section>

<script type="text/javascript">
    $(function () {
    })
</script>
