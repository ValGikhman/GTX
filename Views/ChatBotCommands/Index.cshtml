@using System.Linq
@model GTX.Models.ChatBotCommandPageModel
@{
    ViewBag.Title = "CB commands";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var commands = Model.Commands;
    var actions = Model.Actions;
    var requestToken = GTX.Common.SessionRequestToken.GetOrCreate(ViewContext.HttpContext.Session);
}

<link href="~/Content/chat-bot-commands.css?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/chat-bot-commands.css")).Ticks)" rel="stylesheet" />

<div class="chat-command-mobile-lock d-lg-none">
    <i class="bi bi-display" aria-hidden="true"></i>
    <h1>Desktop workspace</h1>
    <p>CB commands are managed from a desktop-sized screen.</p>
</div>

<div class="d-none d-lg-block"
     data-command-page
     data-create-url="@Url.Action("Create", "ChatBotCommands")"
     data-edit-url="@Url.Action("Edit", "ChatBotCommands")"
     data-delete-url="@Url.Action("Delete", "ChatBotCommands")">
    @Html.Partial("_MarketingHero", null, new ViewDataDictionary
    {
        { "Kicker", "Owner command center" },
        { "Title", "Manage CB commands." },
        { "Accent", "Keep every route precise." },
        { "Description", "Review recognized phrases, inspect their application dependencies, and maintain the commands available to your assistant." },
        { "Word", "COMMANDS" },
        { "Icon", "bi-command" }
    })

    <main class="chat-command-page">
        <div class="container-fluid">
            <section id="chatCommandGridShell" class="majordome-inventory-shell overflow-hidden" aria-label="CB commands">
                <div class="majordome-inventory-header">
                    <div class="chat-command-toolbar">
                        <div class="input-group chat-command-search-wrap">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <label class="visually-hidden" for="chatCommandQuickSearch">Quick search commands</label>
                            <input id="chatCommandQuickSearch" class="form-control" type="text" placeholder="Search phrase / action..." autocomplete="off" data-command-search />
                        </div>

                        <div class="chat-command-toolbar-actions">
                            <button type="button" class="btn btn-gradient" data-command-add>
                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> New
                            </button>
                        </div>
                    </div>
                </div>

                <div class="majordome-inventory-table-wrap table-responsive chat-command-grid-wrap">
                    <table id="chatCommandTable" class="table align-middle m-0 majordome-admin-grid chat-command-grid">
                <colgroup>
                    <col class="chat-command-col-phrase" />
                    <col class="chat-command-col-action" />
                    <col class="chat-command-col-description" />
                    <col class="chat-command-col-role" />
                    <col class="chat-command-col-updated" />
                    <col class="chat-command-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Command phrase</th>
                        <th>Action dependency</th>
                        <th>Description</th>
                        <th>Created by</th>
                        <th>Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody data-command-body>
                    @foreach (var command in commands)
                    {
                        var searchText = string.Join(" ", new[]
                        {
                            command.Phrase, command.NormalizedPhrase, command.ActionLabel, command.ActionKey,
                            command.ActionDescription, command.CreatedByRole
                        }.Where(value => !string.IsNullOrWhiteSpace(value))).ToLowerInvariant();

                        <tr class="chat-command-main-row"
                            data-command-row="@command.Id"
                            data-command-search-text="@searchText">
                            <td>
                                <div class="chat-command-phrase"><i class="bi bi-chat-square-quote" aria-hidden="true"></i><strong>@command.Phrase</strong></div>
                            </td>
                            <td>
                                <div class="chat-command-action-name">@command.ActionLabel</div>
                                <code>@command.ActionKey</code>
                            </td>
                            <td><span class="chat-command-description">@command.ActionDescription</span></td>
                            <td><span class="chat-command-role"><i class="bi bi-person-check" aria-hidden="true"></i>@command.CreatedByRole</span></td>
                            <td>
                                <time datetime="@command.UpdatedUtc.ToString("O")">@command.UpdatedUtc.ToString("MMM d, yyyy")</time>
                            </td>
                            <td>
                                <div class="chat-command-row-actions majordome-actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-command-edit data-command-id="@command.Id" data-command-phrase="@command.Phrase" data-command-action="@command.ActionKey" title="Edit @command.Phrase">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i><span class="visually-hidden">Edit</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger is-delete" data-command-delete data-command-id="@command.Id" data-command-phrase="@command.Phrase" title="Delete @command.Phrase">
                                        <i class="bi bi-trash3" aria-hidden="true"></i><span class="visually-hidden">Delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

                <div class="chat-command-empty @(commands.Count == 0 ? "" : "d-none")" data-command-empty>
                    <span><i class="bi bi-chat-square-dots" aria-hidden="true"></i></span>
                    <h3>No commands found</h3>
                    <p data-command-empty-message>Add the chatbot's first custom phrase.</p>
                </div>
                <footer class="chat-command-grid-footer">
                    <span>Showing <strong data-command-visible>@commands.Count</strong> of <strong data-command-count>@commands.Count</strong> commands</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Owner-only management</span>
                </footer>
            </section>
        </div>
    </main>
</div>

<div class="modal fade chat-command-modal" id="chatCommandWizardModal" tabindex="-1" aria-labelledby="chatCommandWizardTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form data-command-wizard-form novalidate>
                <input type="hidden" name="RequestToken" value="@requestToken" />
                <input type="hidden" name="Id" value="0" />
                <div class="modal-header">
                    <div class="chat-command-modal-title-icon"><i class="bi bi-command" aria-hidden="true"></i></div>
                    <div><h2 class="modal-title" id="chatCommandWizardTitle" data-command-wizard-title>Add command</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ol class="chat-command-wizard-progress" aria-label="Wizard progress">
                        <li class="is-current" data-command-progress="1"><span>1</span><small>Phrase</small></li>
                        <li data-command-progress="2"><span>2</span><small>Action</small></li>
                        <li data-command-progress="3"><span>3</span><small>Review</small></li>
                    </ol>

                    <section data-command-step="1">
                        <label for="chatCommandPhrase">What should the chatbot recognize?</label>
                        <input id="chatCommandPhrase" class="form-control" type="text" name="Phrase" maxlength="300" autocomplete="off" placeholder="Example: lot manager" required />
                        <p class="chat-command-field-help">Use a short, memorable phrase containing letters or numbers.</p>
                        <div class="chat-command-form-error" data-command-error="phrase" hidden>Enter a phrase to continue.</div>
                    </section>

                    <section data-command-step="2" hidden>
                        <label for="chatCommandAction">What should the phrase do?</label>
                        <select id="chatCommandAction" class="form-select" name="ActionKey" required>
                            <option value="">Choose an available action...</option>
                            <optgroup label="Public pages">
                                @foreach (var action in actions.Where(item => !item.RequiresAuthentication))
                                {
                                    <option value="@action.ActionKey" data-label="@action.Label" data-description="@action.Description" data-access="Public">@action.Label (@action.ActionKey)</option>
                                }
                            </optgroup>
                            <optgroup label="Authenticated staff">
                                @foreach (var action in actions.Where(item => item.RequiresAuthentication && !item.OwnerOnly))
                                {
                                    <option value="@action.ActionKey" data-label="@action.Label" data-description="@action.Description" data-access="Authenticated staff">@action.Label (@action.ActionKey)</option>
                                }
                            </optgroup>
                            <optgroup label="Owner only">
                                @foreach (var action in actions.Where(item => item.OwnerOnly))
                                {
                                    <option value="@action.ActionKey" data-label="@action.Label" data-description="@action.Description" data-access="Owner only">@action.Label (@action.ActionKey)</option>
                                }
                            </optgroup>
                        </select>
                        <div class="chat-command-form-error" data-command-error="action" hidden>Choose an action to continue.</div>
                        <div class="chat-command-wizard-action-preview" data-command-action-preview hidden>
                            <div><strong data-command-action-label></strong><span data-command-action-access></span></div>
                            <code data-command-action-key></code><p data-command-action-description></p>
                        </div>
                    </section>

                    <section data-command-step="3" hidden>
                        <div class="chat-command-review-statement"><span>Command mapping</span><code data-command-statement></code></div>
                        <dl class="chat-command-review-list">
                            <div><dt>Phrase</dt><dd data-command-review-phrase></dd></div>
                            <div><dt>Action</dt><dd data-command-review-action></dd></div>
                            <div><dt>Access</dt><dd data-command-review-access></dd></div>
                        </dl>
                        <div class="chat-command-review-note"><i class="bi bi-database-check" aria-hidden="true"></i><span>The command and its audit entry will be saved together.</span></div>
                    </section>

                    <div class="chat-command-save-status" data-command-save-status role="alert" hidden></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-command-back hidden><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
                    <button type="button" class="btn btn-gradient ms-auto" data-command-next>Choose action <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    <button type="submit" class="btn btn-success ms-auto" data-command-save hidden><i class="bi bi-check2-circle" aria-hidden="true"></i> Save command</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/Scripts/chat-bot-commands.js?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/chat-bot-commands.js")).Ticks)"></script>
