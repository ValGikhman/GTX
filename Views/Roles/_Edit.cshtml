@model GTX.Models.SiteRoleModel
@using GTX.Common
@{ var isEdit = Model != null && Model.Id > 0; }
@using (Html.BeginForm("Save", Enums.Controllers.Roles.ToString(), FormMethod.Post, new { id = "roleForm" })) {
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="row g-2">
        <div class="col-12 col-md-6">
            <div class="role-editor-card role-editor-access h-100 overflow-hidden">
                <div class="card-header role-editor-card-header border-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="role-editor-heading"><span class="role-editor-heading-icon"><i class="bi bi-grid-1x2" aria-hidden="true"></i></span><div class="fw-semibold">Menu access</div></div>
                    </div>
                </div>
                <div class="card-body role-editor-permissions">
                    @foreach (var item in MajordomeMenu.Items.Where(i => i.Item != MajordomeItem.Roles && i.Item != MajordomeItem.Profile && i.Item != MajordomeItem.Services)) {
                        var key = item.Item.ToString();
                        <div class="form-check form-switch role-editor-permission">
                            <input class="form-check-input" type="checkbox" name="Permissions" value="@key" id="permission-@key" checked="@((Model.Permissions ?? new string[0]).Contains(key))" />
                            <label class="form-check-label" for="permission-@key">@item.Title</label>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="role-editor-card h-100 overflow-hidden">
                <div class="card-header role-editor-card-header border-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="role-editor-heading"><span class="role-editor-heading-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><div class="fw-semibold">@(isEdit ? "Role details" : "New role")</div></div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label for="Name" class="form-label fw-semibold text-shadow-small"><i class="bi bi-person me-1"></i>Role Name</label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control shadow-sm", maxlength = "40", required = "required", placeholder = "Role name..." })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            <label for="Password" class="form-label fw-semibold text-shadow-small"><i class="bi bi-shield-lock me-1"></i>@(isEdit ? "New Password" : "Password")</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-key"></i></span>
                                <input type="password" id="Password" name="Password" class="form-control" autocomplete="new-password" minlength="8" maxlength="32" required="@(!isEdit)" aria-describedby="rolePasswordPolicy" placeholder="@(isEdit ? "Leave blank to keep current..." : "Password...")" />
                                <button type="button" class="btn btn-outline-secondary toggle-role-password" aria-label="Show password" aria-pressed="false" title="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                            <ul class="list-unstyled small mt-2 mb-0" id="rolePasswordPolicy" aria-label="Password requirements">
                                <li class="text-muted" data-password-rule="length"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>8–32 characters</li>
                                <li class="text-muted" data-password-rule="uppercase"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>Uppercase (A–Z)</li>
                                <li class="text-muted" data-password-rule="lowercase"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>Lowercase (a–z)</li>
                                <li class="text-muted" data-password-rule="number"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>Number (0–9)</li>
                                <li class="text-muted" data-password-rule="symbol"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>Symbol (!, @@, #, $)</li>
                                <li class="text-muted" data-password-rule="whitespace"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>No whitespace</li>
                            </ul>
                        </div>
                        <div class="col-12">
                            <label for="ConfirmPassword" class="form-label fw-semibold text-shadow-small">Confirm Password</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-key" aria-hidden="true"></i></span>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" maxlength="32" aria-describedby="rolePasswordMatch" placeholder="Re-enter password..." />
                                <button type="button" class="btn btn-outline-secondary toggle-role-password" aria-label="Show password" aria-pressed="false" title="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                            <div class="small mt-2 text-muted" id="rolePasswordMatch" aria-live="polite" aria-atomic="true"><i class="bi bi-dash-circle me-1" aria-hidden="true"></i><span class="visually-hidden password-rule-status">Not checked: </span>Passwords match</div>
                        </div>
                        @if (!ViewData.ModelState.IsValid) {
                            <div class="col-12">
                                @Html.ValidationSummary(false, "", new { @class = "text-danger mt-1" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer role-editor-footer border-0 d-flex flex-wrap align-items-center justify-content-end gap-2 py-2">
        <button type="button" class="btn btn-outline-secondary shadow" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Cancel</button>
        <button type="submit" class="btn @(isEdit ? "btn-gradient" : "btn-success") shadow"><i class="bi @(isEdit ? "bi-save" : "bi-plus-circle") me-1"></i>@(isEdit ? "Save" : "Create")</button>
    </div>
}
