        box-shadow: 0 .5rem 1.2rem rgba(15, 23, 42, .08);
    }

    .vehicle-comparison-vehicle-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 3px;
        background: linear-gradient(90deg, rgba(var(--vehicle-heading-accent), 1), rgba(var(--vehicle-heading-accent), .35));
    }

