        background: var(--gtx-grad, var(--gtx-accent-solid, #1e73be));
    }

    .vehicle-comparison-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        border-radius: .9rem;
        overflow: hidden;
        background: rgba(255, 255, 255, .94);
        box-shadow: inset 0 0 0 1px rgba(148, 163, 184, .18);
    }

    .vehicle-comparison-table th,
    .vehicle-comparison-table td {
