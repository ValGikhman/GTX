        --vehicle-heading-accent: 37, 99, 235;
    }

    .vehicle-comparison-vehicle-heading:nth-child(4) {
        --vehicle-heading-accent: 180, 83, 9;
    }

    .vehicle-comparison-vehicle-heading:nth-child(5) {
        --vehicle-heading-accent: 124, 58, 237;
    }

