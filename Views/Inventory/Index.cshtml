        padding: 1rem !important;
        background: transparent !important;
        color: #334155 !important;
        text-shadow: none;
        vertical-align: middle !important;
    }

    .vehicle-comparison-spec-poem {
        display: block;
        border-left: 3px solid var(--gtx-accent-solid, #1e73be);
        padding: .2rem 0 .2rem .75rem;
        color: #334155;
        font-family: Georgia, "Times New Roman", serif;
        font-size: .76rem;
        font-style: italic;
        font-weight: 700;
        letter-spacing: .01em;
        line-height: 1.55;
        text-align: left;
        text-transform: none;
        white-space: pre-line;
