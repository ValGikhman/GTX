<script type="text/javascript">
    $(function () {
        $("#filterTerm").removeClass("rounded-end-4");

        function markAddressCopied($address) {
            if (!$address || !$address.length) return;

            $address.addClass("copied");
            $address.attr("title", "Copied to clipboard");
            setTimeout(function () {
                $address.removeClass("copied");
                $address.attr("title", "Click to copy address");
            }, 1200);
        }

        function fallbackCopyAddress(text, $address) {
            const $temp = $("<textarea readonly></textarea>").val(text).css({
                position: "fixed",
                top: "-9999px",
                left: "-9999px"
            });

            $("body").append($temp);
            $temp[0].focus();
            $temp[0].select();

            try {
                document.execCommand("copy");
            } finally {
                $temp.remove();
                markAddressCopied($address);
            }
        }

        function copyAddress(text, $address) {
            if (!text) return;

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text)
                    .then(function () {
                        markAddressCopied($address);
                    })
                    .catch(function () {
                        fallbackCopyAddress(text, $address);
                    });
                return;
            }

            fallbackCopyAddress(text, $address);
        }

        $("#inventoryAddressCopy, #pageTitleInventoryAddressCopy").on("click keydown", function (e) {
            const key = e.key || "";
            const keyCode = e.keyCode || 0;
            const isKeyboardActivate = e.type === "keydown" && (key === "Enter" || key === " " || keyCode === 13 || keyCode === 32);

            if (e.type === "keydown" && !isKeyboardActivate) return;
            if (isKeyboardActivate) e.preventDefault();

            copyAddress($(this).data("address"), $(this));
        });

        const term = window.gtxInventorySearch
            ? window.gtxInventorySearch.readStoredTerm()
            : sessionStorage.getItem("term");
        if (term === undefined || term === "" || term === null) {
            sessionStorage.removeItem("term");
        }
        else {
            $("#filterTerm").val(term);
            applyFilterTerm(term);
        }

        // For navivation on details page
        let stocks = window.getInventoryMatchedStocks
            ? window.getInventoryMatchedStocks()
            : $("#inventory > li.card").map(function () {
                return $(this).data("stock");
            }).get();

        if (stocks.length > 0) {
            localStorage.setItem("matchedStocks", JSON.stringify(stocks));
            sessionStorage.setItem("lastVisitedPage", window.location.href);
        } else {
            localStorage.removeItem("matchedStocks"); // Clear old if none matched
            sessionStorage.removeItem("lastVisitedPage");

        }

        let detailsNavigationStarted = false;
        $(window).on('pageshow', function (event) {
            detailsNavigationStarted = false;
            if (typeof hideSpinner === "function") {
                hideSpinner("#loadingOverlay");
            }

            loadLastCars();
            loadLikedCars();
            refreshCarLikes();
        });

        $(document).on("visibilitychange", function () {
            if (document.visibilityState === "visible") {
                detailsNavigationStarted = false;
            }
        });

        const comparisonStocks = [];
        const comparisonMaximum = 4;

        function showComparisonMessage(message) {
            if (typeof window.gtxAlert === "function") {
                window.gtxAlert(message);
                return;
            }

            window.alert(message);
        }

        function comparisonVehicleTitle(stock) {
            const $card = $("#inventory .card").filter(function () {
                return String($(this).data("stock") || "").toUpperCase() === stock;
            }).first();
            const yearMake = $.trim($card.find(".gtx-title").first().text());
            const modelStyle = $.trim($card.find(".gtx-trimline").first().text());
            return $.trim(yearMake + " " + modelStyle) || stock;
        }

        function renderComparisonSelection() {
            $("#inventory .gtx-compare-toggle").each(function () {
                const stock = String($(this).data("stock") || "").toUpperCase();
                const selected = comparisonStocks.indexOf(stock) !== -1;
                $(this)
                    .toggleClass("is-selected", selected)
                    .attr("aria-pressed", selected ? "true" : "false")
                    .attr("title", selected ? "Remove from comparison" : "Add to comparison");
                $(this).find("i").attr("class", selected ? "bi bi-check2" : "bi bi-columns-gap");
            });

            const $selection = $("#inventoryCompareSelection").empty();
            $.each(comparisonStocks, function (_, stock) {
                const $chip = $("<span></span>", { "class": "inventory-compare-chip" });
                $("<span></span>", { "class": "inventory-compare-chip-icon" })
                    .append($("<i></i>", { "class": "bi bi-car-front-fill", "aria-hidden": "true" }))
                    .appendTo($chip);
                const $copy = $("<span></span>", { "class": "inventory-compare-chip-copy" }).appendTo($chip);
                $("<span></span>", { "class": "inventory-compare-chip-title" })
                    .text(comparisonVehicleTitle(stock))
                    .appendTo($copy);
                $("<button></button>", {
                    type: "button",
                    "class": "inventory-compare-remove",
                    "data-stock": stock,
                    "aria-label": "Remove " + stock + " from comparison",
                    title: "Remove"
                }).append($("<i></i>", { "class": "bi bi-x-lg" })).appendTo($chip);
                $selection.append($chip);
            });

            $("#inventoryCompareCount").text(comparisonStocks.length + " / " + comparisonMaximum);
            $("#inventoryCompareOpen").prop("disabled", comparisonStocks.length < 2 || comparisonStocks.length > comparisonMaximum);
            $("#inventoryCompareBar").toggleClass("is-visible", comparisonStocks.length > 0);
        }

        $("#inventory").on("click", ".gtx-compare-toggle", function (event) {
            event.preventDefault();
            event.stopPropagation();

            const stock = String($(this).data("stock") || "").toUpperCase();
            if (!stock) return;

            const existingIndex = comparisonStocks.indexOf(stock);
            if (existingIndex !== -1) {
                comparisonStocks.splice(existingIndex, 1);
            } else if (comparisonStocks.length >= comparisonMaximum) {
                showComparisonMessage("You can compare up to 4 vehicles at a time.");
                return;
            } else {
                comparisonStocks.push(stock);
            }

            renderComparisonSelection();
        });

        $("#inventoryCompareSelection").on("click", ".inventory-compare-remove", function () {
            const stock = String($(this).data("stock") || "").toUpperCase();
            const index = comparisonStocks.indexOf(stock);
            if (index !== -1) comparisonStocks.splice(index, 1);
            renderComparisonSelection();
        });

        $("#inventoryCompareClear").on("click", function () {
            comparisonStocks.length = 0;
            renderComparisonSelection();
        });

        $("#inventoryCompareOpen").on("click", function () {
            if (comparisonStocks.length < 2 || comparisonStocks.length > comparisonMaximum) {
                showComparisonMessage("Choose between 2 and 4 vehicles to compare.");
                return;
            }

            const modalElement = document.getElementById("vehicleComparisonModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const $content = $("#vehicleComparisonContent");
            $content.html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading comparison...</span></div><div class="mt-3 text-muted">Building your vehicle comparison...</div></div>');
            modal.show();

            $.ajax({
                url: '@Url.Action("Compare", "Inventory")',
                type: "POST",
                traditional: true,
                timeout: 45000,
                data: {
                    __RequestVerificationToken: $("#inventoryCompareToken input[name='__RequestVerificationToken']").val(),
                    stocks: comparisonStocks.slice()
                }
            }).done(function (html) {
                $content.html(html);
            }).fail(function (xhr) {
                const message = xhr.responseJSON && xhr.responseJSON.message
                    ? xhr.responseJSON.message
                    : "The comparison could not be built. Please try again.";
                $content.empty().append(
                    $("<div></div>", { "class": "alert alert-warning mb-0", role: "alert" }).text(message)
                );
            });
        });

        renderComparisonSelection();

        $("#inventory").on("click", ".card", function (event) {
            if ($(event.target).closest(".gtx-compare-toggle").length) return;
            if (detailsNavigationStarted) return;

            const url = $(this).data("url");
            const stock = $(this).data("stock");
            const fallbackUrl = stock ? `${root}Inventory/Details?stock=${encodeURIComponent(stock)}` : "";

            if (url || fallbackUrl) {
                detailsNavigationStarted = true;
                window.location.href = url || fallbackUrl;
            }
        });

        $(".no-click").on("click", function (e) {
            e.stopPropagation();
        });

        refreshCarLikes();

        $('#sortField, #sortDirection').on('change', function () {
            updateSortDirectionLabel();
            sortInventory();
        });

        updateSortDirectionLabel();

        if (window.applyInventoryPanelFilters) {
            window.applyInventoryPanelFilters();
        }
    })

    function refreshCarLikes() {
        $(".card").each(function () {
            var stock = $(this).data("stock");
            if (isCarLiked(stock)) {
                $(this).find(".liked").show();
            }
            else {
                $(this).find(".liked").hide();
            }
        });
    }

    function sortInventory() {
        var field = $('#sortField').val();
        var desc = $('#sortDirection').is(':checked');
        var $container = $('#inventory');

        if (!field) return; // Do nothing if no field selected

        var $items = $container.find('.card').get();
        var $bottomPaging = $container.find('.inventory-bottom-paging');
        var isTextField = (field === 'make');
        var collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });

        $items.sort(function (a, b) {
            var rawA = $(a).data(field);
            var rawB = $(b).data(field);

            if (isTextField) {
                var valA = (rawA == null ? '' : String(rawA));
                var valB = (rawB == null ? '' : String(rawB));
                var cmp = collator.compare(valA, valB);
                return desc ? -cmp : cmp;
            } else {
                // Clean numbers like "$12,345.00" -> 12345.00
                var numA = parseFloat(String(rawA).replace(/[^0-9.\-]/g, '')) || 0;
                var numB = parseFloat(String(rawB).replace(/[^0-9.\-]/g, '')) || 0;
                var cmp = numA - numB;
                return desc ? -cmp : cmp;
            }
        });

        $container.append($items);
        $container.append($bottomPaging);

        if (window.refreshInventoryPagination) {
            window.refreshInventoryPagination({ resetPage: true, scrollToTop: true });
        }
    }

    function updateSortDirectionLabel() {
        var isChecked = $('#sortDirection').is(':checked');
        $('#sortDirectionLabel').text(isChecked ? 'Z-a' : 'A-z');
    }
</script>
