        position: relative;
        display: grid;
        grid-template-rows: 1fr auto;
        gap: .55rem;
        width: 100%;
        height: 286px;
        overflow: hidden;
        border: 1px solid rgba(var(--vehicle-heading-accent), .22);
        border-radius: .9rem;
        padding: .55rem;
        background:
