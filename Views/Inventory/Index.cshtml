        display: flex !important;
        align-items: center;
        justify-content: center;
        min-height: 1.8rem;
        width: 100%;
        border: 1px solid rgba(var(--vehicle-heading-accent), .2);
        padding: .3rem .4rem;
        background: rgba(var(--vehicle-heading-accent), .1) !important;
        color: rgb(var(--vehicle-heading-accent)) !important;
