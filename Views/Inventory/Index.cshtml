        align-self: center;
        color: #0f172a;
        font-weight: 850;
        line-height: 1.18;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .vehicle-comparison-subtitle {
        display: -webkit-box;
        overflow: hidden;
        align-self: start;
        line-height: 1.15;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .vehicle-comparison-subtitle {
        color: #64748b;
        font-size: .78rem;
    }

