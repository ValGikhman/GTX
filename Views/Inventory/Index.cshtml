            inset 0 1px 0 rgba(255, 255, 255, .95);
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 55%, #94a3b8) #e2e8f0;
    }

    .vehicle-comparison-table-wrap::before {
        position: absolute;
        z-index: 6;
        top: 0;
        right: 1.5rem;
        left: 1.5rem;
