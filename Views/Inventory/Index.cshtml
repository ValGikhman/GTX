        transition: transform .22s ease, opacity .22s ease;
    }

    .inventory-compare-bar::before {
        position: absolute;
        top: 0;
        right: 1.25rem;
        left: 1.25rem;
        height: 3px;
        border-radius: 0 0 999px 999px;
        background: var(--gtx-grad, var(--gtx-accent-solid, #1e73be));
        content: "";
    }

    .inventory-compare-bar.is-visible {
        transform: translate(-50%, 0);
        opacity: 1;
        pointer-events: auto;
    }

    .inventory-compare-bar-inner {
        align-items: stretch !important;
        flex-direction: column;
    }

    .inventory-compare-main {
        min-width: 0;
    }

    .inventory-compare-heading {
        min-width: 0;
        color: #0f172a;
