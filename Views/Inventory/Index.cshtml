        text-underline-offset: 2px;
        cursor: pointer;
    }

    .inventory-contact-address.copied {
        color: #0b7a2f;
        text-decoration-color: #0b7a2f;
    }

    .inventory-contact-map-btn {
        white-space: nowrap;
        padding: .25rem .55rem;
        font-size: .85rem;
        line-height: 1.1;
    }

    .gtx-compare-toggle {
        position: absolute;
        right: .65rem;
        bottom: .65rem;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border: 1px solid color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 55%, #fff);
        border-radius: 999px;
        padding: .38rem .7rem;
        background: var(--gtx-grad, var(--gtx-accent-solid, #1e73be));
        color: #fff;
        font-size: .76rem;
        font-weight: 800;
        box-shadow: 0 .5rem 1.25rem color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 36%, transparent);
        backdrop-filter: blur(7px);
        transition: background-color .18s ease, transform .18s ease, box-shadow .18s ease;
    }

    .gtx-compare-toggle:hover,
    .gtx-compare-toggle:focus-visible {
        background: var(--gtx-grad-rev, var(--gtx-grad, var(--gtx-accent-solid, #1e73be)));
        color: #fff;
        transform: translateY(-1px);
    }

    .gtx-compare-toggle.is-selected {
        border-color: #fff;
        background: linear-gradient(
            180deg,
            #fff,
            color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 15%, #fff));
        color: var(--gtx-accent-solid, #1e73be);
        box-shadow:
            0 0 0 .22rem color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 28%, transparent),
            0 .5rem 1.25rem color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 42%, transparent);
    }

    .inventory-compare-bar {
        position: fixed;
        left: 50%;
        top: calc(var(--gtx-header-height, 0px) + .75rem);
        bottom: auto;
        z-index: 1040;
        width: fit-content;
        min-width: min(350px, calc(100% - 1.25rem));
        max-width: calc(100% - 1.25rem);
        transform: translate(-50%, calc(-100% - 2rem));
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 28%, #fff);
        border-radius: 1.3rem;
        padding: .8rem;
        background:
            radial-gradient(circle at 8% -20%, color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 18%, transparent), transparent 32%),
            linear-gradient(145deg, rgba(255,255,255,.98), rgba(241,245,249,.96));
        box-shadow:
            0 1rem 2.6rem rgba(15, 23, 42, .22),
            0 .35rem 1rem color-mix(in srgb, var(--gtx-accent-solid, #1e73be) 18%, transparent);
